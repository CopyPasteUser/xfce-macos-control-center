def _command_result(command, timeout=4, runner=subprocess.run):
    started = time.monotonic()
    environment = {**os.environ, "LC_ALL": "C"}
    if any(arg.startswith("--diagnose") for arg in sys.argv[1:]) and command[0] == "pactl":
        # An explicit socket prevents libpulse autospawn during read-only probes.
        environment.setdefault("PULSE_SERVER", "unix:" + os.path.join(
            os.environ.get("XDG_RUNTIME_DIR", "/run/user/" + str(os.getuid())), "pulse/native"))
        environment.setdefault("PULSE_CLIENTCONFIG", "/dev/null")
        environment.setdefault("PULSE_RUNTIME_PATH", os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
        cookie = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "pulse/cookie")
        environment.setdefault("PULSE_COOKIE", cookie if os.path.isfile(cookie) else "/dev/null")
        if environment["PULSE_CLIENTCONFIG"] != "/dev/null":
            environment["XDG_CONFIG_HOME"] = os.path.dirname(environment["PULSE_CLIENTCONFIG"])
    try:
        result = runner(command, capture_output=True, text=True, timeout=timeout,
                        env=environment)
    except (OSError, subprocess.TimeoutExpired) as exc:
        logging.warning("backend=%s operation=%s duration=%.3fs error=%s",
                        command[0], command[1], time.monotonic() - started,
                        type(exc).__name__)
        raise
    if result.returncode:
        # Only hardware tools: never log command arguments containing credentials.
        detail = re.sub(r"(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}", "[adapter]",
                        result.stderr or "")[:500] if command[0] in ("bluetoothctl", "rfkill") else ""
        logging.warning("backend=%s operation=%s duration=%.3fs exit=%s stderr=%s",
                        command[0], command[1], time.monotonic() - started,
                        result.returncode, detail)
    return result


def discover_audio_outputs(runner=subprocess.run, available=which):
    """Find real output devices via pipewire-pulse/pactl, then native PipeWire."""
    tools = [tool for tool in ("pactl", "wpctl") if available(tool)]
    if not tools:
        return {"status": "unavailable", "devices": [], "default": "", "backend": ""}
    timed_out = False
    errors = []
    empty_result = None
    for tool in tools:
        try:
            if tool == "pactl":
                result = _command_result([tool, "--format=json", "list", "sinks"], runner=runner)
                if result.returncode:
                    errors.append((result.stderr or result.stdout or "pactl failed").strip())
                    continue
                data = json.loads(result.stdout or "[]")
                if not isinstance(data, list):
                    raise ValueError("invalid sink list")
                if any(not isinstance(row, dict) or not isinstance(row.get("name"), str)
                       or not row["name"] for row in data):
                    raise ValueError("invalid sink entry")
                devices = [{"id": row["name"], "name": row["name"],
                            "description": row.get("description") or row["name"],
                            "backend": "pactl"}
                           for row in data if isinstance(row, dict) and row.get("name")]
                default_result = _command_result([tool, "get-default-sink"], runner=runner)
                default = default_result.stdout.strip() if default_result.returncode == 0 else ""
                value = {"status": "ready" if devices else "empty", "devices": devices,
                         "default": default, "backend": "pactl", "server": ""}
                if devices:
                    if not default or default not in {device["id"] for device in devices}:
                        errors.append("pactl could not identify the default output")
                        continue
                    value["server"] = "PulseAudio-compatible"
                    try:
                        info = _command_result([tool, "info"], timeout=2, runner=runner)
                        match = re.search(r"^Server Name:\s*(.+)$", info.stdout, re.MULTILINE)
                        if info.returncode == 0 and match:
                            value["server"] = ("PipeWire via PulseAudio" if "pipewire" in
                                               match.group(1).lower() else "PulseAudio")
                    except (OSError, subprocess.TimeoutExpired):
                        pass
                    return value
                return value  # a working Pulse server with no sinks is authoritative
            result = _command_result([tool, "status", "-n"], runner=runner)
            if result.returncode:
                errors.append((result.stderr or result.stdout or "wpctl failed").strip())
                continue
            in_sinks = False
            devices = []
            default = ""
            for line in result.stdout.splitlines():
                if re.search(r"\bSinks:\s*$", line):
                    in_sinks = True
                    continue
                if in_sinks and re.search(r"\b(?:Devices|Sources|Filters|Streams):\s*$", line):
                    break
                if not in_sinks:
                    continue
                match = re.search(r"(\*)?\s*(\d+)\.\s+(.+?)(?:\s+\[.*\])?\s*$", line)
                if match:
                    marker, device_id, name = match.groups()
                    devices.append({"id": device_id, "name": name, "description": name,
                                    "backend": "wpctl"})
                    if marker == "*":
                        default = device_id
            if not in_sinks:
                raise ValueError("wpctl output has no Sinks section")
            value = {"status": "ready" if devices else "empty", "devices": devices,
                     "default": default, "backend": "wpctl", "server": "PipeWire"}
            if devices:
                if default in {device["id"] for device in devices}:
                    return value
                errors.append("wpctl could not identify the default output")
                continue
            empty_result = value
        except subprocess.TimeoutExpired:
            timed_out = True
        except (OSError, ValueError, TypeError, json.JSONDecodeError) as exc:
            errors.append(str(exc))
    if timed_out:
        status = "timeout"
    elif empty_result is not None:
        return empty_result
    elif errors and all(any(marker in error.lower() for marker in
                            ("connection refused", "could not connect", "cannot connect",
                             "server not running", "no such file or directory", "no pipewire"))
                        for error in errors):
        status = "backend_unavailable"
    else:
        status = "error"
    return {"status": status, "devices": [], "default": "", "backend": "",
            "detail": errors[-1] if errors else ""}


def set_audio_output(device, runner=subprocess.run):
    """Switch and verify a discovered output; no optimistic state change."""
    command = (["pactl", "set-default-sink", device["id"]] if device["backend"] == "pactl"
               else ["wpctl", "set-default", device["id"]])
    try:
        result = _command_result(command, runner=runner)
        if result.returncode:
            return False
        if device["backend"] == "pactl":
            inputs = _command_result(["pactl", "list", "short", "sink-inputs"], runner=runner)
            if inputs.returncode == 0:
                deadline = time.monotonic() + 2.0
                for line in inputs.stdout.splitlines():
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        break
                    fields = line.split()
                    if fields and fields[0].isdigit():
                        try:
                            _command_result(["pactl", "move-sink-input", fields[0], device["id"]],
                                            timeout=remaining, runner=runner)
                        except (OSError, subprocess.TimeoutExpired):
                            break  # default selection is verified independently below
        verified = discover_audio_outputs(runner=runner, available=lambda name: name == device["backend"])
        return verified["status"] == "ready" and verified["default"] == device["id"]
    except (OSError, subprocess.TimeoutExpired):
        return False


