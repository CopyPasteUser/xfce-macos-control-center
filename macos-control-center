def _split_t(line):
    # nmcli -t: Felder durch ':' getrennt, '\:' ist ein Doppelpunkt im Wert
    parts, cur, esc = [], "", False
    for ch in line:
        if esc:
            cur += ch
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == ":":
            parts.append(cur)
            cur = ""
        else:
            cur += ch
    parts.append(cur)
    return parts


def wifi_connection_summary(networks=None):
    """Return current Wi-Fi details; reuse a network scan when supplied."""
    summary = {"device": "", "connection": "", "ip": "", "gateway": "", "ssid": "", "signal": "", "security": ""}
    try:
        rows = shc("nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status", timeout=3)
        for line in rows.splitlines():
            parts = _split_t(line)
            if len(parts) >= 4 and parts[1].lower() in ("wifi", "802-11-wireless") and "connected" in parts[2].lower():
                summary["device"], summary["connection"] = parts[0], parts[3]
                break
        if summary["device"]:
            summary["ip"] = shc("nmcli", "-g", "IP4.ADDRESS", "device", "show", summary["device"], timeout=3).splitlines()[0].strip()
            summary["gateway"] = shc("nmcli", "-g", "IP4.GATEWAY", "device", "show", summary["device"], timeout=3).splitlines()[0].strip()
        if networks is None:
            networks = wifi_list()
        for ssid, active, signal_pct, security in networks:
            if active:
                summary.update(ssid=ssid, signal=str(signal_pct), security=security or "Open")
                break
        dns = shc("nmcli", "-g", "IP4.DNS", "device", "show", summary["device"], timeout=3) if summary["device"] else ""
        if dns:
            summary["dns"] = ", ".join(item.strip() for item in dns.splitlines() if item.strip())
    except (OSError, subprocess.TimeoutExpired, IndexError):
        pass
    return {key: value for key, value in summary.items() if value}


def wifi_list():
    out = sh("nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list", "--rescan", "no")
    best = {}
    for line in out.splitlines():
        p = _split_t(line)
        if len(p) < 4 or not p[1]:
            continue
        inuse = p[0].strip() == "*"
        try:
            sig = int(p[2])
        except ValueError:
            sig = 0
        cur = best.get(p[1])
        if cur is None or inuse or (sig > cur[1] and not cur[0]):
            best[p[1]] = (inuse, sig, p[3].strip())
    rows = sorted(best.items(), key=lambda kv: (not kv[1][0], -kv[1][1]))[:6]
    return [(ssid, v[0], v[1], v[2]) for ssid, v in rows]


