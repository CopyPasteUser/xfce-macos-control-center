    def _store_quick_actions(self, order):
        updated = dict(CFG)
        updated["quick_actions"] = "auto" if order == "auto" else list(order)
        if not _persist_config(updated):
            return False
        CFG.update(updated)
        info = self._tile_info
        if info is not None:
            self._tiles_build(info)
        if self._act_mode == "tiles":
            self._act_fill()
        return True

    def _reset_quick_actions(self):
        self._store_quick_actions("auto")

    def _toggle_quick_action(self, key, enabled):
        info = self._tile_info
        if info is None:
            return
        available = [sp["key"] for sp in self._tile_specs(info)]
        if key not in available:
            return
        saved = CFG.get("quick_actions", "auto")
        order = available if saved == "auto" or not isinstance(saved, list) else [
            item for item in saved if item in available
        ]
        if enabled and key not in order:
            order.append(key)
        elif not enabled:
            order = [item for item in order if item != key]
        self._store_quick_actions(order)

    def _move_quick_action(self, key, offset):
        info = self._tile_info
        if info is None:
            return
        available = [sp["key"] for sp in self._tile_specs(info)]
        saved = CFG.get("quick_actions", "auto")
        order = available if saved == "auto" or not isinstance(saved, list) else [
            item for item in saved if item in available
        ]
        if key not in order:
            return
        old = order.index(key)
        new = max(0, min(len(order) - 1, old + offset))
        if old == new:
            return
        order.insert(new, order.pop(old))
        self._store_quick_actions(order)

    def _fill_tiles(self):
        self._head(T("customize_tiles"))
        self._item(T("tiles_reset"), self._reset_quick_actions)
        info = self._tile_info
        if info is None:
            lab = Gtk.Label(label=T("tiles_not_ready"), xalign=0)
            self._act_list.pack_start(lab, False, False, 4)
            return

        specs = self._tile_specs(info)
        available = [sp["key"] for sp in specs]
        saved = CFG.get("quick_actions", "auto")
        order = available if saved == "auto" or not isinstance(saved, list) else [
            item for item in saved if item in available
        ]
        selected = set(order)
        positions = {key: index for index, key in enumerate(order)}
        natural = {key: index for index, key in enumerate(available)}
        specs.sort(key=lambda sp: (0, positions[sp["key"]])
                   if sp["key"] in positions else (1, natural[sp["key"]]))

        for sp in specs:
            key = sp["key"]
            active = key in selected
            row = Gtk.Box(spacing=3)
            check = Gtk.CheckButton(label=sp.get("title", key))
            check.set_active(active)
            check.set_tooltip_text(sp.get("tip", sp.get("title", key)))
            check.connect("toggled", lambda button, action_key=key:
                           self._toggle_quick_action(action_key, button.get_active()))
            row.pack_start(check, True, True, 0)

            up = Gtk.Button.new_from_icon_name("go-up-symbolic", Gtk.IconSize.MENU)
            up.set_relief(Gtk.ReliefStyle.NONE)
            up.set_tooltip_text(T("tiles_up"))
            up.get_accessible().set_name(T("tiles_up"))
            up.set_sensitive(active and positions.get(key, 0) > 0)
            up.connect("clicked", lambda _b, action_key=key:
                       self._move_quick_action(action_key, -1))
            row.pack_start(up, False, False, 0)

            down = Gtk.Button.new_from_icon_name("go-down-symbolic", Gtk.IconSize.MENU)
            down.set_relief(Gtk.ReliefStyle.NONE)
            down.set_tooltip_text(T("tiles_down"))
            down.get_accessible().set_name(T("tiles_down"))
            down.set_sensitive(active and positions.get(key, -1) < len(order) - 1)
            down.connect("clicked", lambda _b, action_key=key:
                         self._move_quick_action(action_key, 1))
            row.pack_start(down, False, False, 0)
            self._act_list.pack_start(row, False, False, 1)

