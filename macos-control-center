    def _conf_item(self, key, text, argv):
        holder = []
        holder.append(self._item(text, lambda: self._on_confirm(key, holder[0], text, argv)))

    def _on_confirm(self, key, lab, text, argv):
        if self._confirm_key == key:
            self._clear_confirm()
            self._launch(argv)
            return
        self._clear_confirm()
        self._confirm_key = key
        self._confirm_lab = (lab, text)
        lab.set_text(T("sure", x=text))
        lab.get_style_context().add_class("danger")
        self._confirm_src = GLib.timeout_add(3000, self._confirm_timeout)

    def _confirm_timeout(self):
        self._confirm_src = 0
        self._clear_confirm()
        return False

    def _clear_confirm(self):
        if self._confirm_src:
            GLib.source_remove(self._confirm_src)
            self._confirm_src = 0
        if self._confirm_lab:
            lab, text = self._confirm_lab
            lab.set_text(text)
            lab.get_style_context().remove_class("danger")
        self._confirm_lab = None
        self._confirm_key = None

    # ══════════════════ Live-Aktualisierung (Hintergrund-Thread) ══════════════════
    def _tick_once(self):
        self._tick()
        return False

    def _tick(self):
        if self._destroyed:
            return False
        if self._resident and not self.get_visible() and self._resident_primed:
            return True
        self._refresh_audio_outputs()
        if self._polling:
            self._rerun = True
        else:
            self._polling = True
            self._poll_n += 1
            threading.Thread(target=self._poll_worker, args=(self._poll_n,), daemon=True).start()
        return True

    def _poll_collect(self, n):
        # Leseabfragen parallel; dieser Worker verändert keine GTK-Widgets.
        bt_generation = self._bt_generation
        audio_backend = self._audio_control_backend
        def read_wifi():
            on = wifi_on()
            return on, wifi_ssid() if on else ""

        jobs = {
            "wifi_pair": read_wifi,
            "bt": bluetooth_state,
            "vpn": vpn_state,
            "vol": lambda: volume_pct(audio_backend),
            "mute": lambda: sink_muted(audio_backend),
            "bl": lambda: brightness_pct()[0],
            "kbd": lambda: kbd_pct()[0],
            "bat": battery,
            "bx": battery_extra if n % 3 == 1 else (lambda: None),
            "ns": nightshift_on if self.btn_ns else (lambda: None),
            "media": media_info,
        }

        requirements = {"wifi_pair": "nmcli", "bt": "bluetoothctl", "vpn": "nmcli",
                        "vol": "audio", "mute": "audio", "media": "playerctl"}
        jobs = {key: fn for key, fn in jobs.items()
                if key not in requirements or
                ((which("pactl") or which("wpctl")) if requirements[key] == "audio"
                 else which(requirements[key]))}
        # Alle unabhängigen Abfragen an denselben begrenzten Threadpool geben.
        futures = {
            key: self._poll_executor.submit(func)
            for key, func in jobs.items()
        }

        # Auch Kachelstatus unabhängig voneinander abfragen.
        specs = tuple(self._specs)
        tile_futures = {}
        for sp in specs:
            read = sp.get("read")
            if read:
                try:
                    tile_futures[sp["key"]] = self._poll_executor.submit(read)
                except RuntimeError:
                    pass

        all_futures = {future: (key, False) for key, future in futures.items()}
        all_futures.update({future: (key, True) for key, future in tile_futures.items()})
        errors = []
        for future in as_completed(all_futures):
            key, tile = all_futures[future]
            try:
                value = future.result()
                if tile:
                    data = {"extra": {key: value}}
                elif key == "wifi_pair":
                    data = {"wifi": value[0], "ssid": value[1]}
                else:
                    data = {key: value}
                data["_partial"] = True
                data["_bt_generation"] = bt_generation
                GLib.idle_add(self._apply, data)
            except Exception:
                errors.append(key)
        return {"_errors": errors}

    def _poll_worker(self, n):
        started = time.monotonic()
        try:
            d = self._poll_collect(n)
        except Exception:
            d = {"_errors": ["poll"]}
        d["_elapsed_ms"] = round((time.monotonic() - started) * 1000)
        GLib.idle_add(self._apply, d)

    def _apply(self, d):
        if self._destroyed:
            return False
        try:
            self._updating = True
            chg = self._chg
            # Wi-Fi / Bluetooth / VPN / Night Shift
            if "wifi" in d and chg("wifi", (d["wifi"], d["ssid"])):
                self._st["wifi"] = d["wifi"]
                self._flip(self.btn_wifi, d["wifi"])
                self.btn_wifi[2].set_text(d["ssid"] or (T("on") if d["wifi"] else T("off")))
            if ("bt" in d and not self._bt_pending
                    and d.get("_bt_generation") == self._bt_generation
                    and chg("bt", d["bt"])):
                state = d["bt"]
                self._bt_last_status = state["status"]
                if state.get("powered") is not None:
                    self._st["bt"] = state["powered"]
                    self._flip(self.btn_bt, state["powered"])
                    self.btn_bt[2].set_text(T("on") if state["powered"] else T("off"))
                else:
                    self.btn_bt[2].set_text(T("unavailable"))
            if "vpn" in d and chg("vpn", d["vpn"]):
                self._vpn_apply(d["vpn"])
            if self.btn_ns and d.get("ns") is not None and chg("ns", d["ns"]):
                self._st["ns"] = d["ns"]
                self._flip(self.btn_ns, d["ns"])
                self.btn_ns[2].set_text(T("active") if d["ns"] else T("off"))
            # Regler (nicht direkt nach einer Bedienung überschreiben)
            if GLib.get_monotonic_time() >= self._hold:
                if "vol" in d and chg("vol_value", d["vol"]):
                    self.vol_mod.scale.set_value(d["vol"])
                    if hasattr(self, "_sound_scale"):
                        self._sound_scale.set_value(d["vol"])
                if "mute" in d and chg("mute_value", d["mute"]):
                    self._muted = d["mute"]
                    self._refresh_volume_icon()
                if self.bl_mod is not None and d.get("bl") is not None and chg("bl", d["bl"]):
                    self.bl_mod.scale.set_value(d["bl"])
                if KBD_DIR and d.get("kbd") is not None and chg("kbd", d["kbd"], "kbd_light"):
                    self._apply_kbd_action_level(self._kbd_level_for_percent(d["kbd"]))
            # Akku
            if d.get("bx") is not None:
                self._last_tt = d["bx"][0]
            if "bat" in d:
                self._battery_snapshot = d["bat"]
            cap, st = d.get("bat", getattr(self, "_battery_snapshot", (None, "")) if "bx" in d else (None, ""))
            if cap is not None and self._bat_lab is not None:
                if d.get("bx") is not None:
                    self._last_tt = d["bx"][0]
                    if d["bx"][1]:
                        self._bat_box.set_tooltip_text(d["bx"][1])
                if chg("bat", (cap, st, self._last_tt)):
                    lab, sub = battery_texts(cap, st, self._last_tt)
                    self._bat_lab.set_text(lab)
                    self._bat_sub.set_text(sub)
                    self._bat_ic.set_from_icon_name(battery_icon_name(cap, st), Gtk.IconSize.MENU)
            # Wiedergabe
            if "media" in d and chg("media", d["media"]):
                self._set_media(d["media"])
            # Kacheln
            for sp in self._specs:
                k = sp["key"]
                if k in d.get("extra", {}) and sp.get("apply") and chg("t:" + k, d["extra"][k], k):
                    sp["apply"](d["extra"][k])
        finally:
            self._updating = False
            if not d.get("_partial"):
                self._polling = False
                self._poll_errors = d.get("_errors", [])
                self._poll_ms = d.get("_elapsed_ms", 0)
                self._resident_primed = True
                if hasattr(self, "_header_status"):
                    self._header_status.set_text(T("status_ready"))
                if self._profile_pending:
                    self._configure_polling()
                if self._rerun:
                    self._rerun = False
                    GLib.idle_add(self._tick_once)
        return False


def _write_runtime_state(resident, visible=False):
    """Write non-secret runtime metadata so tools can verify which code is loaded."""
    tmp = None
    try:
        state_dir = os.path.dirname(os.path.abspath(STATEFILE))
        os.makedirs(state_dir, mode=0o700, exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=".macos-control-center-state-", dir=state_dir)
        os.fchmod(fd, 0o600)
        payload = {
            "pid": os.getpid(),
            "version": APP_VERSION,
            "script": os.path.realpath(sys.argv[0]),
            "resident": bool(resident),
            "visible": bool(visible),
            "started_at": PROCESS_STARTED_AT,
            "updated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        }
        with os.fdopen(fd, "w", encoding="utf-8") as state:
            json.dump(payload, state, ensure_ascii=False, indent=2)
            state.write("\n")
        os.replace(tmp, STATEFILE)
        tmp = None
        return True
    except OSError:
        return False
    finally:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def _remove_runtime_state(owner_pid):
    try:
        with open(STATEFILE, encoding="utf-8") as state:
            data = json.load(state)
        if isinstance(data, dict) and data.get("pid") == owner_pid:
            os.unlink(STATEFILE)
    except (OSError, ValueError, TypeError):
        pass


def _runtime_visible_for_pid(pid):
    try:
        with open(STATEFILE, encoding="utf-8") as state_file:
            data = json.load(state_file)
        if isinstance(data, dict) and data.get("pid") == pid and isinstance(data.get("visible"), bool):
            return data["visible"]
    except (OSError, ValueError, TypeError):
        pass
    return None


def _is_control_center(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return b"macos-control-center" in f.read()
    except OSError:
        return False


def _is_resident_control_center(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            args = f.read().split(b"\0")
        return (
            b"--daemon" in args
            and any(b"macos-control-center" in a for a in args)
        )
    except OSError:
        return False


def diagnose(mode="--diagnose"):
    """Read-only probes; no GTK window, config write, service activation or power action."""
    report = {"version": APP_VERSION, "script": os.path.realpath(__file__),
              "session": os.environ.get("XDG_SESSION_TYPE", "unknown")}

    def probe(argv):
        if not which(argv[0]):
            return {"status": "unavailable", "exit": None, "output": ""}
        try:
            value = _command_result(argv, timeout=4)
            output = re.sub(r"(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}", "[redacted]",
                            value.stdout + value.stderr)
            return {"status": "success" if value.returncode == 0 else "command_failed",
                    "exit": value.returncode, "output": output.strip()[:2000]}
        except subprocess.TimeoutExpired:
            return {"status": "timeout", "exit": None, "output": ""}
        except OSError:
            return {"status": "unavailable", "exit": None, "output": ""}

    if mode in ("--diagnose", "--diagnose-bluetooth"):
        listed = probe(["bluetoothctl", "list"])
        shown = probe(["bluetoothctl", "show"])
        # Names/aliases can contain personal information. Keep only controller count
        # and the capabilities needed to diagnose a power operation.
        count = len(re.findall(r"^Controller\s", listed["output"], re.M))
        properties = {}
        for key in ("Powered", "Discoverable", "Pairable"):
            match = re.search(r"^\s*" + key + r":\s*(yes|no)", shown["output"], re.M)
            properties[key.lower()] = match.group(1) == "yes" if match else None
        listed["output"] = "controllers=" + str(count)
        shown["output"] = properties
        report["bluetooth"] = {
            "backend": "bluetoothctl (system BlueZ)",
            "tools": {name: bool(which(name)) for name in ("bluetoothctl", "bluetoothd", "rfkill", "gdbus")},
            "service": probe(["systemctl", "is-active", "bluetooth.service"]),
            "system_bus_bluez_owner": probe(["gdbus", "call", "--system", "--dest",
                "org.freedesktop.DBus", "--object-path", "/org/freedesktop/DBus", "--method",
                "org.freedesktop.DBus.NameHasOwner", "org.bluez"]),
            "list": listed, "show": shown,
            "rfkill": probe(["rfkill", "list", "bluetooth"]),
            "state": bluetooth_state(),
        }
    if mode in ("--diagnose", "--diagnose-audio"):
        audio = discover_audio_outputs()
        devices = audio.get("devices", [])
        # Sink names may embed a Bluetooth address or hostname: use a local index.
        report["audio"] = {"status": audio["status"], "backend": audio.get("backend", ""),
            "server": audio.get("server", "unknown"), "outputs": len(devices),
            "default_output_index": next((i for i, d in enumerate(devices)
                if d["id"] == audio.get("default")), None),
            "tools": {name: bool(which(name)) for name in ("pactl", "wpctl", "pipewire")}}
        backend = audio.get("backend")
        command = (["pactl", "get-sink-volume", "@DEFAULT_SINK@"] if backend == "pactl"
                   else ["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
        report["audio"]["volume_readable"] = bool(backend) and probe(command)["status"] == "success"
        mute_command = (["pactl", "get-sink-mute", "@DEFAULT_SINK@"] if backend == "pactl" else command)
        report["audio"]["mute_readable"] = bool(backend) and probe(mute_command)["status"] == "success"
    if mode == "--diagnose":
        report["capabilities"] = {name: bool(which(tool)) for name, tool in {
            "network_cli": "nmcli", "media_cli": "playerctl", "battery_cli": "upower",
            "sensors_cli": "sensors", "storage_cli": "lsblk", "display_cli": "xrandr"}.items()}
        report["gtk"] = "%s.%s.%s" % (Gtk.get_major_version(), Gtk.get_minor_version(), Gtk.get_micro_version())
        report["config_path"] = CONFIG_FILE
    print(json.dumps(report, indent=2, ensure_ascii=False))


def main():
    diagnostic = next((arg for arg in sys.argv[1:] if arg.startswith("--diagnose")), None)
    if diagnostic:
        if diagnostic not in ("--diagnose", "--diagnose-bluetooth", "--diagnose-audio"):
            raise SystemExit("Unknown diagnostic mode")
        # libpulse can create a cookie even for a read command. Use a private,
        # ephemeral client configuration; never start a server or create a
        # persistent PulseAudio configuration/cookie during diagnostics.
        with tempfile.TemporaryDirectory(prefix="cc-diagnose-") as directory:
            client = os.path.join(directory, "client.conf")
            with open(client, "w", encoding="ascii") as stream:
                stream.write("autospawn = no\ncookie-file = /dev/null\n")
            os.environ["PULSE_CLIENTCONFIG"] = client
            diagnose(diagnostic)
        return
    if "--direct" in sys.argv[1:]:
        # A terminal debugging instance must not signal an old resident process.
        # It neither publishes nor removes the resident's PID/runtime files.
        logging.basicConfig(level=logging.INFO)
        win = ControlCenter()
        win.show_all()
        win.present()
        Gtk.main()
        return
    resident = "--daemon" in sys.argv[1:]
    internal_restart = os.environ.pop("CC_INTERNAL_RESTART", "") == "1"
    # Register the Unix signal source before publishing the PID. The launcher
    # additionally waits for Runtime state written by an idle callback after
    # Gtk.main() starts, so normal starter clicks never target a half-built window.
    win_holder = {"win": None}
    if resident:
        # GLib dispatches SIGUSR1 on its main loop, so widget access happens on
        # the GTK thread. Runtime readiness is published only after this loop
        # starts; the launcher won't signal while the widget tree is building.
        def on_show_signal():
            win = win_holder["win"]
            if win is not None:
                win._force_show()
            return True

        def on_hide_signal():
            win = win_holder["win"]
            if win is not None:
                win._force_hide()
            return True

        GLib.unix_signal_add(
            GLib.PRIORITY_DEFAULT, signal.SIGUSR1, on_show_signal
        )
        GLib.unix_signal_add(
            GLib.PRIORITY_DEFAULT, signal.SIGUSR2, on_hide_signal
        )

    if os.path.exists(PIDFILE) and not internal_restart:
        try:
            with open(PIDFILE) as f:
                pid = int(f.read().strip())
        except (OSError, ValueError):
            pid = 0

        if pid and _is_control_center(pid):
            if _is_resident_control_center(pid):
                if not resident:
                    try:
                        visible = _runtime_visible_for_pid(pid)
                        os.kill(pid, signal.SIGUSR2 if visible is True else signal.SIGUSR1)
                    except (ProcessLookupError, PermissionError):
                        pass
                return

            if not resident:
                try:
                    os.kill(pid, signal.SIGTERM)
                except (ProcessLookupError, PermissionError):
                    pass
                return

            try:
                os.kill(pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass
            deadline = time.monotonic() + 1.0
            while time.monotonic() < deadline and _is_control_center(pid):
                time.sleep(0.05)

        try:
            with open(PIDFILE) as f:
                owner = int(f.read().strip())
            if owner == pid:
                os.unlink(PIDFILE)
        except (OSError, ValueError):
            pass

    with open(PIDFILE, "w", encoding="ascii") as f:
        f.write(str(os.getpid()))

    win = ControlCenter()
    win._resident = resident
    win_holder["win"] = win
    win._runtime_state_callback = lambda: _write_runtime_state(
        resident, visible=win.get_visible()
    )

    win.show_all()
    win.set_keep_above(True)

    force_visible = os.environ.pop("CC_START_VISIBLE", "") == "1"
    if resident and not force_visible:
        win.hide()
    else:
        win.present()
        win.grab_focus()

    def publish_ready():
        # Publish metadata only once GTK is handling events. Launchers wait
        # for this state before sending the initial toggle signal.
        _write_runtime_state(resident, visible=win.get_visible())
        return False

    GLib.idle_add(publish_ready)
    try:
        Gtk.main()
    finally:
        try:
            with open(PIDFILE) as f:
                owner = int(f.read().strip())
            if owner == os.getpid():
                os.unlink(PIDFILE)
                _remove_runtime_state(os.getpid())
        except (OSError, ValueError):
            _remove_runtime_state(os.getpid())


if __name__ == "__main__":
    main()
