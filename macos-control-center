    def _on_destroy(self, *a):
        self._destroyed = True
        if self._focus_source:
            GLib.source_remove(self._focus_source)
        # ausstehende (entprellte) Regleränderungen noch ausführen
        for key in list(self._deb):
            src, fn, args = self._deb.pop(key)
            GLib.source_remove(src)
            try:
                fn(*args)
            except Exception:
                pass
        for attr in ("_resize_debounce_id", "_resize_anim_id", "_toast_src", "_poll_source", "_focus_hide_src"):
            source_id = getattr(self, attr, 0)
            if source_id:
                try:
                    GLib.source_remove(source_id)
                except Exception:
                    pass
                setattr(self, attr, 0)
        try:
            self._poll_executor.shutdown(wait=False)
        except Exception:
            pass
        Gtk.main_quit()

