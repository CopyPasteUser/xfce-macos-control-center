NM_NAME = "org.freedesktop.NetworkManager"
NM_PATH = "/org/freedesktop/NetworkManager"
_NM_KM_PSK, _NM_KM_8021X, _NM_KM_SAE = 0x100, 0x200, 0x400


def _nm_call(bus, path, iface, method, params=None, timeout=5000):
    return bus.call_sync(NM_NAME, path, iface, method, params, None,
                         Gio.DBusCallFlags.NONE, timeout, None)


def _nm_props(bus, path, iface):
    r = _nm_call(bus, path, "org.freedesktop.DBus.Properties", "GetAll", GLib.Variant("(s)", (iface,)))
    return r.unpack()[0]


def nm_connect_new_wifi(ssid, password, timeout=35):
    # "ok" | "failed" | "not_found" | "unsupported" | "error"   (läuft im Hintergrund-Thread)
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        ssid_b = ssid.encode("utf-8")
        best = None
        for dev in _nm_call(bus, NM_PATH, NM_NAME, "GetDevices").unpack()[0]:
            if _nm_props(bus, dev, "org.freedesktop.NetworkManager.Device").get("DeviceType") != 2:
                continue
            aps = _nm_call(bus, dev, "org.freedesktop.NetworkManager.Device.Wireless",
                           "GetAccessPoints").unpack()[0]
            for ap in aps:
                pr = _nm_props(bus, ap, "org.freedesktop.NetworkManager.AccessPoint")
                if bytes(pr.get("Ssid", b"")) != ssid_b:
                    continue
                if best is None or pr.get("Strength", 0) > best[2].get("Strength", 0):
                    best = (dev, ap, pr)
        if best is None:
            return "not_found"
        dev, ap, pr = best
        km_all = pr.get("RsnFlags", 0) | pr.get("WpaFlags", 0)
        if km_all & _NM_KM_PSK:
            km = "wpa-psk"
        elif km_all & _NM_KM_SAE:
            km = "sae"
        else:
            return "unsupported"          # 802.1X (Firmen-WLAN), WEP, …
        V = GLib.Variant
        settings = {
            "connection": {"id": V("s", ssid), "type": V("s", "802-11-wireless"),
                           "uuid": V("s", str(uuid.uuid4())), "autoconnect": V("b", True)},
            "802-11-wireless": {"ssid": V("ay", ssid_b), "mode": V("s", "infrastructure")},
            "802-11-wireless-security": {"key-mgmt": V("s", km), "psk": V("s", password)},
            "ipv4": {"method": V("s", "auto")},
            "ipv6": {"method": V("s", "auto")},
        }
        sp, active = _nm_call(bus, NM_PATH, NM_NAME, "AddAndActivateConnection",
                              V("(a{sa{sv}}oo)", (settings, dev, ap)), 15000).unpack()
        settings = None
        end = time.monotonic() + timeout
        while time.monotonic() < end:
            try:
                st = _nm_props(bus, active, "org.freedesktop.NetworkManager.Connection.Active").get("State")
            except Exception:
                st = 4                    # Objekt verschwunden = Verbindung beendet
            if st == 2:
                return "ok"
            if st in (3, 4):
                break
            time.sleep(0.5)
        # fehlgeschlagen (meist falsches Passwort): halbfertiges Profil wieder entfernen
        try:
            _nm_call(bus, NM_PATH, NM_NAME, "DeactivateConnection", GLib.Variant("(o)", (active,)))
        except Exception:
            pass
        try:
            _nm_call(bus, sp, "org.freedesktop.NetworkManager.Settings.Connection", "Delete")
        except Exception:
            pass
        return "failed"
    except Exception:
        return "error"


# ── Bluetooth ──
def bt_on():
    return bluetooth_state()["powered"] is True


def _bluetooth_error_status(message):
    text = (message or "").lower()
    if any(word in text for word in ("not authorized", "notauthorized", "permission denied", "access denied", "operation not permitted")):
        return "permission"
    if "timed out" in text or "timeout" in text:
        return "timeout"
    if any(word in text for word in ("serviceunknown", "namehasnoowner", "connection refused", "failed to connect", "org.bluez not available")):
        return "service"
    return "error"


def bluetooth_state(runner=subprocess.run):
    """Read adapter state without assuming a successful bluetoothctl process."""
    if not which("bluetoothctl"):
        return {"status": "unavailable", "powered": None}
    try:
        listed = _command_result(["bluetoothctl", "list"], timeout=5, runner=runner)
    except subprocess.TimeoutExpired:
        return {"status": "timeout", "powered": None}
    except OSError as exc:
        return {"status": _bluetooth_error_status(str(exc)), "powered": None}
    if listed.returncode or not re.search(r"Controller\s+[0-9A-Fa-f:]{17}", listed.stdout):
        message = listed.stderr or listed.stdout
        if not listed.returncode and not message.strip():
            if which("gdbus"):
                try:
                    owner = _command_result(["gdbus", "call", "--system", "--dest",
                        "org.freedesktop.DBus", "--object-path", "/org/freedesktop/DBus",
                        "--method", "org.freedesktop.DBus.NameHasOwner", "org.bluez"],
                        timeout=2, runner=runner)
                    if owner.returncode == 0 and "false" in owner.stdout:
                        return {"status": "service", "powered": None}
                except (OSError, subprocess.TimeoutExpired):
                    pass  # owner unknown; do not misreport a missing service
            return {"status": "adapter_unavailable", "powered": None}
        status = _bluetooth_error_status(message)
        return {"status": status, "powered": None}
    try:
        shown = _command_result(["bluetoothctl", "show"], timeout=5, runner=runner)
    except subprocess.TimeoutExpired:
        return {"status": "timeout", "powered": None}
    except OSError as exc:
        return {"status": _bluetooth_error_status(str(exc)), "powered": None}
    if shown.returncode:
        return {"status": _bluetooth_error_status(shown.stderr or shown.stdout), "powered": None}
    match = re.search(r"^\s*Powered:\s*(yes|no)\s*$", shown.stdout, re.MULTILINE | re.IGNORECASE)
    if not match:
        return {"status": "adapter_unavailable", "powered": None}
    return {"status": "ready", "powered": match.group(1).lower() == "yes"}


def bluetooth_set_power(enabled, runner=subprocess.run):
    """Request BlueZ power, unblock only a soft block, then verify real state."""
    current = bluetooth_state(runner=runner)
    logging.info("Bluetooth backend=bluetoothctl operation=power target=%s state=%s powered_before=%s",
                 enabled, current["status"], current["powered"])
    if current["status"] != "ready" and not (enabled and current["status"] == "adapter_unavailable"):
        return current
    def failed(status):
        observed = bluetooth_state(runner=runner)
        actual = observed.get("powered") if observed.get("status") == "ready" else current["powered"]
        return {"status": status, "powered": actual}
    if current["powered"] is bool(enabled):
        return current
    if enabled and which("rfkill"):
        try:
            blocked = _command_result(["rfkill", "list", "bluetooth"], timeout=3, runner=runner)
            if blocked.returncode == 0:
                text = blocked.stdout.lower()
                logging.info("Bluetooth rfkill soft_blocked=%s hard_blocked=%s",
                             bool(re.search(r"soft blocked:\s*yes", text)),
                             bool(re.search(r"hard blocked:\s*yes", text)))
                if re.search(r"hard blocked:\s*yes", text):
                    return {"status": "blocked", "powered": False}
                if re.search(r"soft blocked:\s*yes", text):
                    unblocked = _command_result(["rfkill", "unblock", "bluetooth"], timeout=3, runner=runner)
                    if unblocked.returncode:
                        status = _bluetooth_error_status(unblocked.stderr or unblocked.stdout)
                        return failed("permission" if status == "error" else status)
                    # A platform rfkill switch may hide the controller entirely.
                    # Unblocking must precede adapter discovery in that case.
                    if current["status"] == "adapter_unavailable":
                        # BlueZ processes the rfkill uevent asynchronously.
                        for attempt in range(4):
                            current = bluetooth_state(runner=runner)
                            if current["status"] != "adapter_unavailable":
                                break
                            if attempt < 3:
                                time.sleep(0.15)
        except subprocess.TimeoutExpired:
            return {"status": "timeout", "powered": False}
        except OSError as exc:
            return {"status": _bluetooth_error_status(str(exc)), "powered": False}
    if current["status"] != "ready":
        return current
    try:
        action = _command_result(["bluetoothctl", "power", "on" if enabled else "off"],
                                 timeout=8, runner=runner)
    except subprocess.TimeoutExpired:
        return failed("timeout")
    except OSError as exc:
        return {"status": _bluetooth_error_status(str(exc)), "powered": current["powered"]}
    if action.returncode or re.search(r"failed|not available|notready|notauthorized", action.stdout, re.I):
        status = _bluetooth_error_status(action.stderr or action.stdout)
        logging.warning("Bluetooth power command failed: exit=%s status=%s detail=%s",
                        action.returncode, status,
                        re.sub(r"(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}", "[adapter]",
                               action.stderr or action.stdout)[:500])
        return failed("permission" if status == "error" and "permission" in
                      (action.stderr + action.stdout).lower() else status)
    verified = bluetooth_state(runner=runner)
    logging.info("Bluetooth power readback: status=%s powered_after=%s",
                 verified["status"], verified["powered"])
    if verified["status"] != "ready":
        return verified
    if verified["powered"] is not bool(enabled):
        logging.warning("Bluetooth power verification failed: before=%s requested=%s after=%s",
                        current["powered"], enabled, verified["powered"])
        return {"status": "error", "powered": verified["powered"]}
    return verified


def bt_devices():
    # nur bei Bedarf aufgerufen (Detail-Liste), nicht im Poll
    def parse(txt):
        d = {}
        for line in txt.splitlines():
            parts = line.split(None, 2)
            if len(parts) >= 3 and parts[0] == "Device":
                d[parts[1]] = parts[2]
        return d
    paired = parse(shc("bluetoothctl", "devices", "Paired")) or parse(shc("bluetoothctl", "paired-devices"))
    rows = []
    for mac, name in list(paired.items())[:8]:
        info = shc("bluetoothctl", "info", mac, timeout=3)
        conn = "Connected: yes" in info
        bat = None
        m = re.search(r"Battery Percentage:.*\((\d+)\)", info)
        if m and conn:
            bat = int(m.group(1))
        rows.append((mac, name, conn, bat))
    return sorted(rows, key=lambda r: (not r[2], r[1].lower()))[:6]


