    def _select_category(self, key):
        self._category = key
        self._render_actions()

    def _render_actions(self):
        if not hasattr(self, "_tiles_holder") or self._destroyed:
            return
        for child in self._tiles_holder.get_children():
            child.destroy()
        self._tiles.clear()
        self._tsvg.clear()
        for key, button in self._category_buttons.items():
            ctx = button.get_style_context()
            ctx.add_class("selected-category") if key == self._category else ctx.remove_class("selected-category")
        query = self._action_search.get_text()
        shown = _filter_actions(self._specs, query, self._category, not self._expanded_actions)
        self._shown_actions = shown
        grid = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True)
        for i, sp in enumerate(shown):
            grid.attach(self._make_tile(sp), i % 4, i // 4, 1, 1)
        self._tiles_holder.pack_start(grid, False, False, 0)
        if not shown:
            label = Gtk.Label(label=T("no_actions"))
            label.get_style_context().add_class("subtitle")
            self._tiles_holder.pack_start(label, False, False, 8)
        if not query and self._category == "all" and len(self._specs) > 8:
            button = Gtk.Button(label=T("less_actions" if self._expanded_actions else "more_actions"))
            button.get_style_context().add_class("listitem")
            button.connect("clicked", self._toggle_action_extent)
            self._tiles_holder.pack_start(button, False, False, 2)
        self._tiles_holder.show_all()
        # Restore already known statuses without launching new subprocesses on search.
        for sp in self._specs:
            key = "t:" + sp["key"]
            if sp.get("apply") and key in self._last and not self._busy.get(sp["key"]):
                sp["apply"](self._last[key])
        self._schedule_dynamic_resize(45)

    def _toggle_action_extent(self, *_):
        self._expanded_actions = not self._expanded_actions
        self._save_setting("compact_actions", not self._expanded_actions)
        self._render_actions()

    def _activate_search(self, *_):
        if getattr(self, "_shown_actions", []):
            self._shown_actions[0]["click"]()

    def _tiles_refresh_worker(self, specs):
        futures = {}
        for sp in specs:
            read = sp.get("read")
            if read:
                try:
                    futures[sp["key"]] = self._poll_executor.submit(read)
                except RuntimeError:
                    pass

        extra = {}
        for key, future in futures.items():
            try:
                extra[key] = future.result()
            except Exception:
                pass

        GLib.idle_add(self._tiles_refresh_apply, extra)

    def _tiles_refresh_apply(self, extra):
        if self._destroyed:
            return False
        try:
            self._updating = True
            for sp in self._specs:
                key = sp["key"]
                if (key in extra and sp.get("apply")
                        and self._chg("t:" + key, extra[key], key)):
                    sp["apply"](extra[key])
        finally:
            self._updating = False
        return False

    def _make_tile(self, sp):
        box = Gtk.Box()
        box.get_style_context().add_class("module")
        box.get_style_context().add_class("quick-tile")
        box.set_hexpand(True)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        col.set_margin_top(8)
        col.set_margin_bottom(8)
        col.set_margin_start(4)
        col.set_margin_end(4)
        initial_on = bool(self._st.get(sp["key"], False))
        btn = Gtk.Button()
        btn_ctx = btn.get_style_context()
        btn_ctx.add_class("knob")
        if initial_on:
            btn_ctx.add_class("on")
        btn.set_image(svg_image(sp["svg"], color=(ACCENT if initial_on else _inactive_icon_color())))
        btn.set_always_show_image(True)
        btn.set_halign(Gtk.Align.CENTER)
        btn.set_tooltip_text(sp.get("tip", sp["title"]))
        try:
            btn.get_accessible().set_name(sp["title"])
            btn.get_accessible().set_description(sp.get("tip", sp["title"]))
        except Exception:
            pass
        btn.connect("clicked", lambda _b, s=sp: s["click"]())
        btn.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        btn.connect("button-press-event", self._tile_button_press, sp)
        t = Gtk.Label(label=sp["title"])
        t.get_style_context().add_class("ttitle")
        s = Gtk.Label(label=sp.get("sub", ""))
        s.get_style_context().add_class("tsub")
        for lbl in (t, s):
            lbl.set_ellipsize(3)
            lbl.set_max_width_chars(10)
        col.pack_start(btn, False, False, 0)
        col.pack_start(t, False, False, 0)
        col.pack_start(s, False, False, 0)
        box.pack_start(col, True, True, 0)
        self._tiles[sp["key"]] = (btn, s)
        self._tsvg[sp["key"]] = sp["svg"]
        return box

    def _tile_button_press(self, button, event, spec):
        if event.button != 3:
            return False
        candidates = [tuple(cmd) for cmd in _settings_candidates(spec.get("key", ""))
                     if cmd and which(cmd[0])]
        if not candidates:
            self._toast(T("settings_unavailable"))
            return True
        menu = Gtk.Menu()
        for index, argv in enumerate(candidates):
            label = T("tile_context_settings") if index == 0 else os.path.basename(argv[0])
            item = Gtk.MenuItem(label=label)
            item.connect("activate", lambda _item, command=argv: self._launch(list(command)))
            menu.append(item)
        menu.show_all()
        if hasattr(menu, "popup_at_pointer"):
            menu.popup_at_pointer(event)
        else:
            menu.popup(None, None, None, None, event.button, event.time)
        return True

    def _tile_set(self, key, on=None, warn=None, sub=None, svg=None):
        t = self._tiles.get(key)
        if not t:
            return
        btn, lab = t
        ctx = btn.get_style_context()
        if on is not None:
            ctx.add_class("on") if on else ctx.remove_class("on")
        if warn is not None:
            ctx.add_class("warn") if warn else ctx.remove_class("warn")
        if sub is not None:
            lab.set_text(sub)
        if svg is not None and self._tsvg.get(key) != svg:
            self._tsvg[key] = svg
        icon_name = self._tsvg.get(key)
        if icon_name:
            img = svg_image(icon_name, color=(ACCENT if ctx.has_class("on") else _inactive_icon_color()))
            btn.set_image(img)
            img.show()

