    # Audio-Ausgabe
    def _out_apply(self, v):
        if not isinstance(v, dict):
            v = {"status": "error", "devices": [], "default": "", "backend": ""}
        status = v.get("status", "error")
        devices = list(v.get("devices", []))
        current = v.get("default", "")
        self._sinks, self._sink_cur = devices, current
        self._audio_control_backend = v.get("backend", "")
        self._audio_backend = v.get("server") or self._audio_control_backend
        controls_ready = status == "ready" and self._audio_control_backend in ("pactl", "wpctl")
        for control in (getattr(self, "vol_mod", None), getattr(self, "_sound_scale", None),
                        getattr(self, "_sound_mute_button", None),
                        getattr(self, "_sound_mic_switch", None)):
            if control is not None:
                control.set_sensitive(controls_ready)
        desc = next((d.get("description", d.get("name", ""))
                     for d in devices if d.get("id") == current), "")
        self._audio_status = status
        if status != "ready":
            message = {"loading": "loading", "empty": "audio_empty", "unavailable": "unavailable",
                       "backend_unavailable": "audio_backend_unavailable",
                       "timeout": "audio_timeout", "error": "audio_error"}.get(status, "audio_error")
            desc = T(message)
        self._tile_set("out", sub=desc)
        if hasattr(self, "_sound_output"):
            self._sound_output.set_text(desc or T("unavailable"))
            self._sound_output_button.set_sensitive(status == "ready" and len(devices) > 1)
            self._sound_output_button.set_tooltip_text(
                T("tip_out") if len(devices) > 1 else
                T("single_output") if status == "ready" else desc)
        t = self._tiles.get("out")
        if t:
            t[0].set_tooltip_text(T("tip_out_now", d=desc) if status == "ready" else desc)

    def _refresh_audio_outputs(self):
        if self._audio_refreshing or self._busy.get("out"):
            return
        self._audio_refreshing = True
        self._audio_generation += 1
        generation = self._audio_generation
        if self._audio_status != "ready":
            self._out_apply({"status": "loading", "devices": [], "default": ""})
        threading.Thread(target=self._audio_refresh_worker, args=(generation,), daemon=True).start()

    def _audio_refresh_worker(self, generation):
        try:
            result = sinks()
        except subprocess.TimeoutExpired:
            result = {"status": "timeout", "devices": [], "default": "", "backend": ""}
        except Exception:
            logging.exception("Audio discovery worker failed")
            result = {"status": "error", "devices": [], "default": "", "backend": ""}
        GLib.idle_add(self._audio_refresh_apply, generation, result)

    def _audio_refresh_apply(self, generation, result):
        if generation == self._audio_generation:
            self._audio_refreshing = False
        if generation == self._audio_generation and not self._destroyed:
            self._out_apply(result)
        return False

    def _out_click(self):
        if self._audio_status != "ready" or len(self._sinks) < 2 or self._busy.get("out"):
            return
        ids = [device["id"] for device in self._sinks]
        nxt_id = ids[(ids.index(self._sink_cur) + 1) % len(ids)] if self._sink_cur in ids else ids[0]
        device = next(item for item in self._sinks if item["id"] == nxt_id)
        self._busy["out"] = True
        self._audio_generation += 1
        generation = self._audio_generation
        if hasattr(self, "_sound_output_button"):
            self._sound_output_button.set_sensitive(False)
        threading.Thread(target=self._out_worker, args=(generation, device), daemon=True).start()

    def _out_worker(self, generation, device):
        try:
            success = set_audio_output(device)
            result = sinks()
        except Exception:
            success = False
            result = {"status": "error", "devices": [], "default": "", "backend": ""}
        GLib.idle_add(self._out_done, generation, success, result)

    def _out_done(self, generation, success, result):
        if generation != self._audio_generation or self._destroyed:
            return False
        self._audio_refreshing = False
        self._busy["out"] = False
        self._last.pop("t:out", None)
        self._out_apply(result)
        if not success:
            self._toast(T("audio_error"), error=True)
        return False

