SVG_CACHE = {}


def svg_image(name, size=18, color=None):
    from gi.repository import GdkPixbuf
    color = color or _inactive_icon_color()
    key = (name, size, color)
    if key in SVG_CACHE:
        return Gtk.Image.new_from_pixbuf(SVG_CACHE[key])
    loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
    loader.set_size(size, size)
    svg = SVGS[name].replace("#ffffff", color).replace("#FFFFFF", color)
    loader.write(svg.encode())
    loader.close()
    pixbuf = loader.get_pixbuf()
    if len(SVG_CACHE) >= 128:
        SVG_CACHE.pop(next(iter(SVG_CACHE)))
    SVG_CACHE[key] = pixbuf
    return Gtk.Image.new_from_pixbuf(pixbuf)


