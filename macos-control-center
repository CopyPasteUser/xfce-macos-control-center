        controller_button = Gtk.Button(label=T("fan_open_controller")) if controller else None
        for button in (refresh_button, export_button, controller_button):
            if button is not None:
                button.get_style_context().add_class("knob")
                actions.pack_start(button, True, True, 0)
        content.pack_start(actions, False, False, 0)

        state = {"reading": False, "closed": False, "sensors": [], "history": {}, "timer": 0}

        def render(sensors, error=None):
            state["reading"] = False
            refresh_button.set_sensitive(True)
            progress.hide()
            for child in sensor_box.get_children():
                sensor_box.remove(child)
            if state["closed"]:
                return False
            if error:
                summary.set_text(T("fan_read_error") + ": " + str(error)[:160])
                sensor_box.pack_start(Gtk.Label(label=T("fan_no_sensors"), xalign=0), False, False, 4)
                sensor_box.show_all()
                return False

            state["sensors"] = list(sensors)
            fans = sum(1 for sensor in sensors if sensor["kind"] == "fan")
            temps = [sensor["value"] for sensor in sensors if sensor["kind"] == "temperature"]
            hottest = max(temps) if temps else None
            summary_text = T("fan_summary", fans=fans, temps=len(temps),
                             hottest=(f"{hottest:.1f} °C" if hottest is not None else "—"))
            summary.set_text(summary_text)

            if not sensors:
                sensor_box.pack_start(Gtk.Label(label=T("fan_no_sensors"), xalign=0), False, False, 4)
            now = time.strftime("%H:%M:%S")
            for sensor in sensors:
                key = sensor["key"]
                history = state["history"].setdefault(key, [])
                history.append(float(sensor["value"]))
                del history[:-60]

                card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                card.get_style_context().add_class("module")
                for margin in ("top", "bottom", "start", "end"):
                    getattr(card, "set_margin_" + margin)(8)
                top = Gtk.Box(spacing=8)
                label = Gtk.Label(label=sensor["name"], xalign=0)
                label.set_ellipsize(3)
                label.set_max_width_chars(30)
                label.set_hexpand(True)
                value_text = f"{sensor['value']:.1f} °C" if sensor["kind"] == "temperature" else f"{sensor['value']:.0f} RPM"
                value = Gtk.Label(label=value_text, xalign=1)
                value.get_style_context().add_class("title")
                top.pack_start(label, True, True, 0)
                top.pack_end(value, False, False, 0)
                card.pack_start(top, False, False, 0)

                minimum, maximum, critical = sensor.get("minimum"), sensor.get("maximum"), sensor.get("critical")
                limit_values = []
                if minimum is not None:
                    limit_values.append("min " + (f"{minimum:.1f}" if sensor["kind"] == "temperature" else f"{minimum:.0f}"))
                if maximum is not None:
                    limit_values.append("max " + (f"{maximum:.1f}" if sensor["kind"] == "temperature" else f"{maximum:.0f}"))
                if critical is not None:
                    limit_values.append("crit " + f"{critical:.1f}")
                status_key = "fan_status_normal"
                if sensor["kind"] == "temperature":
                    if critical is not None and sensor["value"] >= critical:
                        status_key = "fan_status_hot"
                    elif (maximum is not None and sensor["value"] >= maximum) or sensor["value"] >= 80:
                        status_key = "fan_status_warm"
                status = Gtk.Label(label=T(status_key) + (" · " + " / ".join(limit_values) if limit_values else ""), xalign=0)
                status.get_style_context().add_class("subtitle")
                card.pack_start(status, False, False, 0)

                cap = critical if sensor["kind"] == "temperature" and critical else maximum
                if cap is None or cap <= 0:
                    cap = 100.0 if sensor["kind"] == "temperature" else max(float(sensor["value"]), 1.0) * 1.25
                bar = Gtk.ProgressBar()
                bar.set_fraction(max(0.0, min(1.0, float(sensor["value"]) / float(cap))))
                bar.set_show_text(True)
                bar.set_text(value_text)
                card.pack_start(bar, False, False, 0)
                hist_min, hist_max = min(history), max(history)
                hist_avg = sum(history) / len(history)
                if sensor["kind"] == "temperature":
                    trend_text = T("fan_history_temp", min=f"{hist_min:.1f}", avg=f"{hist_avg:.1f}", max=f"{hist_max:.1f}", count=len(history))
                else:
                    trend_text = T("fan_history_rpm", min=f"{hist_min:.0f}", avg=f"{hist_avg:.0f}", max=f"{hist_max:.0f}", count=len(history))
                trend = Gtk.Label(label=trend_text + " · " + now, xalign=0)
                trend.get_style_context().add_class("subtitle")
                card.pack_start(trend, False, False, 0)
                sensor_box.pack_start(card, False, False, 0)
            sensor_box.show_all()
            return False

        def refresh_async(*_args):
            if state["reading"] or state["closed"]:
                return False
            state["reading"] = True
            refresh_button.set_sensitive(False)
            progress.show()
            progress.pulse()
            def worker():
                try:
                    sensors = self._read_fan_sensors()
                    GLib.idle_add(render, sensors, None)
                except Exception as exc:
                    GLib.idle_add(render, [], str(exc))
            threading.Thread(target=worker, daemon=True).start()
            return False

        def periodic_refresh():
            if state["closed"]:
                state["timer"] = 0
                return False
            refresh_async()
            return True

        def export_csv(*_args):
            sensors = state.get("sensors", [])
            if not sensors:
                self._toast(T("fan_no_sensors"), error=True)
                return
            save_dialog = Gtk.FileChooserDialog(title=T("fan_export_csv"), transient_for=dialog,
                action=Gtk.FileChooserAction.SAVE)
            save_dialog.add_button(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL)
            save_dialog.add_button(Gtk.STOCK_SAVE, Gtk.ResponseType.ACCEPT)
            save_dialog.set_current_name("fan-sensors.csv")
            if save_dialog.run() == Gtk.ResponseType.ACCEPT:
                target = save_dialog.get_filename()
                try:
                    with open(target, "w", encoding="utf-8", newline="") as handle:
                        writer = csv.writer(handle)
                        writer.writerow(["timestamp", "chip", "sensor", "kind", "value", "unit", "minimum", "maximum", "critical", "source"])
                        timestamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
                        for sensor in sensors:
                            writer.writerow([timestamp, sensor.get("chip", ""), sensor.get("name", ""),
                                sensor.get("kind", ""), sensor.get("value", ""), sensor.get("unit", ""),
                                sensor.get("minimum", ""), sensor.get("maximum", ""),
                                sensor.get("critical", ""), sensor.get("path", "")])
                    self._toast(T("fan_exported"))
                except OSError:
                    self._toast(T("settings_failed"), error=True)
            save_dialog.destroy()

        refresh_button.connect("clicked", refresh_async)
        export_button.connect("clicked", export_csv)
        if controller_button is not None:
            def open_controller(*_args):
                try:
                    subprocess.Popen([controller], stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                except OSError:
                    self._toast(T("launch_error"), error=True)
            controller_button.connect("clicked", open_controller)
        dialog.show_all()
        progress.show()
        state["timer"] = GLib.timeout_add_seconds(3, periodic_refresh)
        refresh_async()
        dialog.run()
        state["closed"] = True
        timer_id = state.get("timer", 0)
        if timer_id:
            try: GLib.source_remove(timer_id)
            except Exception: pass
        dialog.destroy()

    # Screenshot-Menü
    def _shot_dir(self):
        d = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
        return d or os.path.expanduser("~")

    def _fill_shot(self):
        self._head(T("shot_title"))
        self._item(T("shot_full"), lambda: self._shot("-f"))
        self._item(T("shot_region"), lambda: self._shot("-r"))
        self._item(T("shot_window"), lambda: self._shot("-w"))
        self._item(T("shot_delay", v=(T("delay_none") if not self._ss_delay else f"{self._ss_delay} s")),
                   self._ss_cycle_delay)
        self._item(T("shot_save", v=(T("save_dialog"), T("save_clip"), T("save_folder"))[self._ss_mode]),
                   self._ss_cycle_mode)
        self._item(T("shot_open"), lambda: self._launch(["xdg-open", self._shot_dir()]))

    def _ss_cycle_delay(self):
        self._ss_delay = {0: 3, 3: 5}.get(self._ss_delay, 0)
        self._act_fill()

    def _ss_cycle_mode(self):
        self._ss_mode = (self._ss_mode + 1) % 3
        self._act_fill()

    def _shot(self, flag):
        cmd = ["xfce4-screenshooter", flag]
        if self._ss_delay:
            cmd += ["-d", str(self._ss_delay)]
        if self._ss_mode == 1:
            cmd += ["-c"]
        elif self._ss_mode == 2:
            cmd += ["-s", self._shot_dir()]
        # kurz warten, damit das Control Center nicht mit im Bild ist
        self._launch(["sh", "-c", 'sleep 0.6; exec "$@"', "sh"] + cmd)

    # Energie-Menü: symbolbasierte Aktionen, Beschriftungen als Tooltips/Accessibility.
    def _power_icon_action(self, row, key, icon, label, argv, confirm=False):
        button = Gtk.Button()
        button.get_style_context().add_class("knob")
        button.get_style_context().add_class("power-action")
        button.set_image(svg_image(icon, 20))
        button.set_always_show_image(True)
        button.set_tooltip_text(label)
        button.set_size_request(42, 42)
        try:
            button.get_accessible().set_name(label)
            button.get_accessible().set_description(label)
        except Exception:
            pass

        def clicked(_button):
            if not confirm:
                self._launch(list(argv))
                return
            if self._power_confirm_key == key:
                self._clear_power_confirmation()
                self._launch(list(argv))
                return
            self._clear_power_confirmation()
            self._power_confirm_key = key
            self._power_confirm_button = button
            self._power_confirm_label = label
            button.get_style_context().add_class("warn")
            button.set_tooltip_text(T("power_confirm_tip", x=label))
            self._power_confirm_src = GLib.timeout_add(3200, self._power_confirm_expired)

        button.connect("clicked", clicked)
        row.pack_start(button, True, True, 0)

    def _power_confirm_expired(self):
        self._power_confirm_src = 0
        button = self._power_confirm_button
        if button is not None:
            button.get_style_context().remove_class("warn")
            if self._power_confirm_label:
                button.set_tooltip_text(self._power_confirm_label)
        self._power_confirm_key = None
        self._power_confirm_button = None
        self._power_confirm_label = None
        return False

    def _clear_power_confirmation(self):
        source = self._power_confirm_src
        self._power_confirm_src = 0
        if source:
            try:
                GLib.source_remove(source)
            except Exception:
                pass
        return self._power_confirm_expired()

