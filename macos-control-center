def _fmt_dur(val):
    # "4.6 hours" -> "4 Std. 36 Min."
    parts = val.split()
    try:
        num = float(parts[0].replace(",", "."))
        factor = {"seconds": 1 / 60, "minutes": 1, "hours": 60, "days": 1440}[parts[1]]
    except (IndexError, ValueError, KeyError):
        return ""
    h, m = divmod(int(round(num * factor)), 60)
    if h and m:
        return T("dur_hm", h=h, m=m)
    if h:
        return T("dur_h", h=h)
    return T("dur_m", m=m) if m else ""


def battery_extra():
    # ein einziger upower-Aufruf: (Restzeit-Text, Tooltip-Text)
    if not BAT_UPOWER:
        return "", ""
    try:
        out = subprocess.run(["upower", "-i", BAT_UPOWER], capture_output=True, text=True,
                             timeout=4, env={**os.environ, "LC_ALL": "C"}).stdout
    except Exception:
        return "", ""
    vals = {}
    for line in out.splitlines():
        k, _, v = line.strip().partition(":")
        vals[k.strip()] = v.strip()
    tt = ""
    for key in ("time to empty", "time to full"):
        if key in vals:
            tt = _fmt_dur(vals[key])
            break
    parts = []
    try:
        parts.append(T("det_health", n=round(float(vals['capacity'].rstrip('%')))))
    except (KeyError, ValueError):
        pass
    try:
        w = float(vals["energy-rate"].split()[0])
        if w > 0:
            parts.append(T("det_power", w=f"{w:.1f}"))
    except (KeyError, ValueError, IndexError):
        pass
    cyc = vals.get("charge-cycles", "")
    if cyc and cyc != "0":
        parts.append(T("det_cycles", n=cyc))
    return tt, "\n".join(parts)


