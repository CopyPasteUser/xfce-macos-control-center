    def _pw_toggle_visible(self, entry, pos, ev):
        vis = not entry.get_visibility()
        entry.set_visibility(vis)
        entry.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY,
                                      "view-conceal-symbolic" if vis else "view-reveal-symbolic")

    def _pw_key(self, entry, ev):
        if ev.keyval == Gdk.KEY_Escape:       # bricht nur die Eingabe ab, schließt nicht das Fenster
            self._pw_cancel()
            return True
        return False

    def _pw_set_sensitive(self, on):
        if self._pw_entry is not None:
            self._pw_entry.set_sensitive(on)
        if self._pw_ok is not None:
            self._pw_ok.set_sensitive(on)

    def _pw_close(self):
        self._pw_generation = getattr(self, "_pw_generation", 0) + 1
        if self._pw_entry is not None:
            self._pw_entry.set_text("")
        self._pw_active = False
        self._pw_entry = self._pw_msg = self._pw_ok = None
        self._busy["wifi"] = False
        self._last.pop("wifi", None)
        self._tick()

    def _pw_cancel(self, *a):
        self._pw_close()
        self._detail_reload()

    def _pw_submit(self, *a):
        if not self._pw_active or self._pw_entry is None or not self._pw_entry.get_sensitive():
            return
        pw = self._pw_entry.get_text()
        if not (8 <= len(pw) <= 63 or (len(pw) == 64 and all(c in "0123456789abcdefABCDEF" for c in pw))):
            self._pw_msg.set_text(T("pw_short"))
            return
        self._pw_entry.set_text("")           # Passwort sofort aus dem Widget entfernen
        self._pw_set_sensitive(False)
        self._pw_msg.set_text(T("connecting"))
        self._pw_generation = getattr(self, "_pw_generation", 0) + 1
        threading.Thread(target=self._pw_worker,
                         args=(self._pw_ssid, pw, self._pw_generation), daemon=True).start()

    def _pw_worker(self, ssid, pw, generation):
        status = nm_connect_new_wifi(ssid, pw)
        pw = None
        GLib.idle_add(self._pw_done, ssid, status, generation)

    def _pw_done(self, ssid, status, generation):
        if self._destroyed or generation != self._pw_generation or ssid != self._pw_ssid:
            return False
        if not self._pw_active:               # inzwischen abgebrochen
            return False
        if status == "ok":
            self._pw_close()
            self.btn_wifi[2].set_text(ssid)
            self._detail_reload()
            return False
        self._pw_set_sensitive(True)
        key = {"failed": "pw_wrong", "not_found": "wifi_not_found",
               "unsupported": "wifi_unsupported"}.get(status, "wifi_error")
        self._pw_msg.set_text(T(key))
        self._pw_entry.grab_focus()
        return False

    def _bt_toggle(self, mac, connected):
        self.btn_bt[2].set_text(T("disconnecting") if connected else T("connecting"))
        self._busy["bt"] = True
        threading.Thread(target=self._bt_device_worker, args=(mac, connected), daemon=True).start()

    def _bt_device_worker(self, mac, connected):
        ok = False
        try:
            r = subprocess.run(
                ["bluetoothctl", "disconnect" if connected else "connect", mac],
                capture_output=True, timeout=20)
            ok = r.returncode == 0
        except Exception:
            ok = False
        GLib.idle_add(self._bt_done, ok)

    def _bt_done(self, ok=True):
        if self._destroyed:
            return False
        self._busy["bt"] = False
        self._last.pop("bt", None)
        if ok:
            self.btn_bt[2].set_text(T("on"))
            self._detail_reload()
        else:
            self.btn_bt[2].set_text(T("failed"))
            if self._detail_mode == "bt":
                self._detail_set_msg(T("bt_error"))
                GLib.timeout_add(3500, self._detail_reload_once)
            else:
                self._detail_reload()
        return False

    # ══════════════════ Regler ══════════════════
    def on_brightness(self, scale):
        if self._updating:
            return
        self._hold_sliders()
        self._debounced("bl", self._apply_brightness, scale.get_value())

    def _apply_brightness(self, pct):
        # Latest value wins; one bounded worker, never a synchronous D-Bus call
        # in GTK's input handler and never one worker for every slider movement.
        with self._brightness_lock:
            self._brightness_pending = round(pct * self._bl_max / 100)
            if self._brightness_running:
                return
            self._brightness_running = True
        threading.Thread(target=self._brightness_worker, daemon=True).start()

    def _brightness_worker(self):
        while True:
            with self._brightness_lock:
                val = self._brightness_pending
                self._brightness_pending = None
                if val is None:
                    self._brightness_running = False
                    return
            try:
                bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
                bus.call_sync("org.freedesktop.login1",
                              "/org/freedesktop/login1/session/auto",
                              "org.freedesktop.login1.Session", "SetBrightness",
                              GLib.Variant("(ssu)", ("backlight", BACKLIGHT, val)),
                              None, Gio.DBusCallFlags.NONE, 1500, None)
            except Exception:
                GLib.idle_add(self._brightness_failed)

    def _brightness_failed(self):
        if not self._destroyed:
            self._toast(T("settings_failed"), error=True)
        return False

    def on_volume(self, scale):
        if self._updating:
            return
        self._hold_sliders()
        self._refresh_volume_icon()
        self._debounced("vol", self._apply_volume, round(scale.get_value()))

    def _audio_control_command(self, pulse_args, pipewire_args):
        if self._audio_control_backend == "wpctl" or not which("pactl"):
            return ["wpctl"] + pipewire_args
        return ["pactl"] + pulse_args

    def _apply_volume(self, pct):
        if self._muted:
            self._muted = False
            subprocess.Popen(self._audio_control_command(
                ["set-sink-mute", "@DEFAULT_SINK@", "0"],
                ["set-mute", "@DEFAULT_AUDIO_SINK@", "0"]))
            self._refresh_volume_icon()
        subprocess.Popen(self._audio_control_command(
            ["set-sink-volume", "@DEFAULT_SINK@", f"{pct}%"],
            ["set-volume", "@DEFAULT_AUDIO_SINK@", f"{pct}%"]))

    def _refresh_volume_icon(self):
        v = self.vol_mod.scale.get_value()
        if self._muted or v <= 0:
            n = "audio-volume-muted-symbolic"
        elif v < 34:
            n = "audio-volume-low-symbolic"
        elif v < 67:
            n = "audio-volume-medium-symbolic"
        else:
            n = "audio-volume-high-symbolic"
        self.vol_mod.icon.set_from_icon_name(n, Gtk.IconSize.MENU)
        if hasattr(self, "_sound_mute_icon"):
            self._sound_mute_icon.set_from_icon_name(n, Gtk.IconSize.MENU)

    def on_mute(self, w, ev=None):
        if ev is not None and getattr(ev, "button", 1) != 1:
            return False
        self._muted = not self._muted
        self._hold_sliders()
        value = "1" if self._muted else "0"
        subprocess.Popen(self._audio_control_command(
            ["set-sink-mute", "@DEFAULT_SINK@", value],
            ["set-mute", "@DEFAULT_AUDIO_SINK@", value]))
        self._refresh_volume_icon()
        return True

    @staticmethod
    def _kbd_level_for_percent(pct):
        if pct is None or pct <= 0:
            return 0
        return 1 if pct < 70 else 2

    def _read_kbd_action_level(self):
        pct, maximum = kbd_pct()
        if pct is None or maximum <= 0:
            return None
        return self._kbd_level_for_percent(pct)

    def _apply_kbd_action_level(self, level):
        if level is None:
            return False
        level = max(0, min(2, int(level)))
        self._st["kbd_light"] = level
        label = T(("kbd_off", "kbd_on", "kbd_bright")[level])
        self._tile_set("kbd_light", on=level > 0, sub=label, svg="kbd_light")
        return False

    def _cycle_kbd_level(self):
        if not KBD_DIR or not self._kbd_max:
            self._toast(T("settings_unavailable"), error=True)
            return
        pct, maximum = kbd_pct()
        if pct is None or maximum <= 0:
            self._toast(T("settings_unavailable"), error=True)
            return
        current = self._kbd_level_for_percent(pct)
        # Hardware with only 0/1 supports two real levels, not a fake middle step.
        levels = (0, 1, 2) if maximum >= 2 else (0, 2)
        try:
            target = levels[(levels.index(current) + 1) % len(levels)]
        except ValueError:
            target = levels[0]
        self._apply_kbd_action_level(target)
        self._busy_for("kbd_light", 1200)
        threading.Thread(target=self._kbd_level_worker, args=(target,), daemon=True).start()

    def _kbd_level_worker(self, level):
        try:
            maximum = int(self._kbd_max)
            values = (0, max(1, (maximum + 1) // 2), maximum)
            value = values[level]
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            bus.call_sync(
                "org.freedesktop.login1",
                "/org/freedesktop/login1/session/auto",
                "org.freedesktop.login1.Session", "SetBrightness",
                GLib.Variant("(ssu)", ("leds", KBD_NAME, value)),
                None, Gio.DBusCallFlags.NONE, 3000, None,
            )
            GLib.idle_add(self._kbd_level_done, level, None)
        except Exception as exc:
            GLib.idle_add(self._kbd_level_done, level, str(exc)[:180])

    def _kbd_level_done(self, level, error):
        if self._destroyed:
            return False
        self._busy["kbd_light"] = False
        self._last.pop("t:kbd_light", None)
        if error:
            actual, _maximum = kbd_pct()
            if actual is not None:
                self._apply_kbd_action_level(self._kbd_level_for_percent(actual))
            self._toast(T("settings_failed"), error=True)
            return False
        values = (0, max(1, (self._kbd_max + 1) // 2), self._kbd_max)
        self._kbd_last = values[level]
        self._apply_kbd_action_level(level)
        self._toast(T(("kbd_off", "kbd_on", "kbd_bright")[level]), timeout_ms=1300)
        return False

