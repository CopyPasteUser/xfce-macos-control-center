    def _can_open_user_folder(self):
        return bool(which("xdg-open") or any(which(cmd) for cmd in ("thunar", "nemo", "dolphin", "pcmanfm")))

    def _open_user_folder(self, folder):
        home = os.path.expanduser("~")
        if folder == "home":
            path = home
        elif folder == "downloads":
            path = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD) or os.path.join(home, "Downloads")
        elif folder == "screenshots":
            pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES) or os.path.join(home, "Pictures")
            candidate = os.path.join(pictures, "Screenshots")
            path = candidate if os.path.isdir(candidate) else pictures
        else:
            path = home
        if not os.path.isdir(path):
            path = home
        if which("xdg-open"):
            self._launch(["xdg-open", path])
            return
        for command in ("thunar", "nemo", "dolphin", "pcmanfm"):
            if which(command):
                self._launch([command, path])
                return
        self._toast(T("settings_unavailable"), error=True)

    def _show_desktop_click(self):
        current = bool(self._st.get("show_desktop", False))
        target = not current
        try:
            subprocess.Popen(["wmctrl", "-k", "on" if target else "off"],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            self._st["show_desktop"] = target
            self._dismiss()
        except OSError:
            self._toast(T("launch_error"), error=True)

    def _dnd_apply(self, enabled):
        if enabled is None:
            return
        self._st["dnd"] = bool(enabled)
        self._tile_set("dnd", on=bool(enabled), sub=T("dnd_on") if enabled else T("dnd_off"))

    def _dnd_click(self):
        current = self._st.get("dnd")
        if current is None:
            if which("xfce4-notifyd-config"):
                self._launch(["xfce4-notifyd-config"])
            else:
                self._toast(T("settings_unavailable"), error=True)
            return
        target = not current
        self._tile_set("dnd", on=target, sub=T("dnd_on") if target else T("dnd_off"))
        threading.Thread(target=self._dnd_worker, args=(target,), daemon=True).start()

    def _dnd_worker(self, target):
        try:
            result = subprocess.run(
                ["xfconf-query", "-c", "xfce4-notifyd", "-p", "/do-not-disturb", "-s", "true" if target else "false"],
                capture_output=True, text=True, timeout=2,
            )
            ok = result.returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            ok = False
        GLib.idle_add(self._dnd_done, target, ok, notification_dnd_state())

    def _dnd_done(self, target, command_ok, actual):
        if self._destroyed:
            return False
        if command_ok and actual is not None and actual == target:
            self._dnd_apply(actual)
            self._toast(T("dnd_on") if actual else T("dnd_off"), timeout_ms=1600)
        else:
            self._dnd_apply(actual if actual is not None else not target)
            self._toast(T("settings_failed"), error=True)
        return False

