def _cfg_value(key, val):
    if key in ("media_progress", "media_hide_idle", "feedback"):
        return val if isinstance(val, bool) else None
    if key == "schema_version":
        return 1 if type(val) is int and val == 1 else None
    # gibt den bereinigten Wert zurück oder None, wenn er nicht plausibel ist
    if key == "resource_profile":
        return val if isinstance(val, str) and val in ("light", "balanced", "responsive", "custom") else None
    elif key == "compact_actions":
        return val if isinstance(val, bool) else None
    elif key == "media_card":
        return val if isinstance(val, bool) else None
    elif key == "devices":
        return _validate_devices(val)
    elif key == "vpn_preferred":
        if isinstance(val, str) and len(val) <= 64 and all(c.isprintable() for c in val):
            return val
    elif key == "poll_seconds":
        if isinstance(val, (int, float)) and not isinstance(val, bool) and 3 <= val <= 60:
            return int(round(val))
    elif key == "language":
        if isinstance(val, str) and val.lower() in _CFG_LANGS:
            return val.lower()
    elif key == "quick_actions":
        if val == "auto":
            return "auto"
        if (isinstance(val, list)
                and len(val) <= len(QUICK_ACTION_KEYS)
                and all(type(item) is str and item in QUICK_ACTION_KEYS for item in val)
                and len(set(val)) == len(val)):
            return list(val)
    elif key == "reduce_motion":
        if isinstance(val, bool):
            return val
    elif key == "stay_open":
        if isinstance(val, bool):
            return val
    elif key == "theme":
        if isinstance(val, str) and val in _CFG_THEMES:
            return val
    elif key == "accent_color":
        if isinstance(val, str) and val in _CFG_ACCENTS:
            return val
    elif key == "animation_speed":
        if isinstance(val, str) and val in ("smooth", "fast", "off"):
            return val
    elif key == "media_thumbnail":
        if isinstance(val, bool):
            return val
    return None



def _validate_devices(value):
    """No shell commands, credentials or arbitrary URI handlers in saved devices."""
    if not isinstance(value, list) or len(value) > 30:
        return None
    cleaned = []
    for row in value:
        if not isinstance(row, dict):
            return None
        name, url, mac = (row.get(k, "") for k in ("name", "url", "mac"))
        broadcast = row.get("broadcast", "255.255.255.255")
        if not all(isinstance(v, str) for v in (name, url, mac, broadcast)):
            return None
        if not name.strip() or len(name) > 64 or not name.isprintable() or len(url) > 2048:
            return None
        if url:
            try:
                parsed = urllib.parse.urlsplit(url)
                if (parsed.scheme not in ("http", "https") or not parsed.hostname
                        or parsed.username is not None or parsed.password is not None
                        or any(c.isspace() for c in url)):
                    return None
                parsed.port
            except ValueError:
                return None
        if mac and not re.fullmatch(r"(?:[0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}", mac):
            return None
        try:
            ipaddress.IPv4Address(broadcast)
        except ValueError:
            return None
        if not url and not mac:
            return None
        cleaned.append(dict(name=name.strip(), url=url, mac=mac, broadcast=broadcast))
    return cleaned


def _magic_packet(mac):
    if not re.fullmatch(r"(?:[0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}", mac):
        raise ValueError("Invalid MAC")
    return b"\xff" * 6 + bytes.fromhex(mac.replace(":", "").replace("-", "")) * 16


def _send_wol(mac, broadcast):
    ipaddress.IPv4Address(broadcast)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        sock.settimeout(2)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        sock.sendto(_magic_packet(mac), (broadcast, 9))


def _resource_policy(profile, cores=None, custom_seconds=10):
    cores = max(1, cores or os.cpu_count() or 1)
    seconds, ceiling = {"light": (30, 2), "balanced": (10, 4),
                        "responsive": (3, 8), "custom": (custom_seconds, 4)}.get(profile, (10, 4))
    return int(seconds), min(ceiling, max(2, cores))


def _action_category(key):
    if key in ("localsend", "network_settings", "bluetooth_manager", "plane", "devices"):
        return "connections"
    if key in ("quick_notes", "focus", "home", "downloads", "files", "terminal", "clipboard", "app_finder"):
        return "tools"
    return "device"


def _filter_actions(specs, query="", category="all", compact=False):
    query = query.strip().casefold()
    result = [sp for sp in specs if (category == "all" or _action_category(sp["key"]) == category)
              and (not query or query in (sp.get("title", "") + " " + sp["key"] + " " + sp.get("tip", "")).casefold())]
    return result[:8] if compact and not query and category == "all" else result


def _system_snapshot():
    """Cheap procfs reads: no subprocess, disk walk or network mounts."""
    result = {"cores": os.cpu_count() or 1}
    try:
        result["load"] = os.getloadavg()[0]
        with open("/proc/meminfo") as stream:
            mem = {line.split(":")[0]: int(line.split()[1]) for line in stream}
        result["ram_total"] = mem["MemTotal"] / 1048576
        result["ram_used"] = (mem["MemTotal"] - mem.get("MemAvailable", mem.get("MemFree", 0))) / 1048576
        with open("/proc/uptime") as stream:
            result["uptime"] = int(float(stream.read().split()[0]) / 60)
    except (OSError, ValueError, KeyError):
        pass
    return result

def _write_default_config():
    # nur beim ersten Start; überschreibt nie etwas
    try:
        os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
        fd = os.open(CONFIG_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(DEFAULT_CONFIG, f, indent=2, ensure_ascii=False)
            f.write("\n")
    except OSError:
        pass


def _persist_config(cfg):
    """Atomare Konfigurationsspeicherung mit restriktiven Dateirechten."""
    fd = None
    tmp = None
    try:
        if os.path.islink(CONFIG_DIR) or os.path.islink(CONFIG_FILE):
            return False
        os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
        os.chmod(CONFIG_DIR, 0o700)
        # Preserve corrupt data for recovery before replacing it with defaults.
        # Refuse to downgrade a config written by a newer schema.
        previous = {}
        if os.path.exists(CONFIG_FILE):
            with open(CONFIG_FILE, "rb") as original:
                raw = original.read(65537)
            try:
                previous = json.loads(raw)
                if not isinstance(previous, dict):
                    raise ValueError("config is not an object")
                version = previous.get("schema_version", 1)
                if type(version) is int and version > 1:
                    return False
            except (ValueError, UnicodeError):
                previous = {}
                if len(raw) > 65536:
                    return False  # do not truncate a larger unknown file
                backup_fd, backup = tempfile.mkstemp(prefix="config-corrupt-", suffix=".json", dir=CONFIG_DIR)
                with os.fdopen(backup_fd, "wb") as preserved:
                    preserved.write(raw)
                    preserved.flush()
                    os.fsync(preserved.fileno())
                logging.warning("Corrupt configuration preserved in a private recovery file")
        fd, tmp = tempfile.mkstemp(prefix=".config-", dir=CONFIG_DIR)
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            fd = None
            json.dump({**previous, **cfg}, f, indent=2, ensure_ascii=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, CONFIG_FILE)
        tmp = None
        os.chmod(CONFIG_FILE, 0o600)
        return True
    except (OSError, TypeError, ValueError):
        return False
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def _order_quick_actions(specs, order):
    """Sortiert verfügbare Kacheln und blendet nicht gewählte Keys aus."""
    specs = list(specs)
    if order == "auto" or not isinstance(order, list):
        return specs
    by_key = {sp.get("key"): sp for sp in specs}
    return [by_key[key] for key in order if key in by_key]


def _adaptive_height(content_height, available_height):
    """Clamp desired popup height to the actual usable screen area."""
    content = max(1, int(content_height))
    available = max(1, int(available_height))
    return min(content, available)


def _ease_out_cubic(progress):
    """Smooth easing curve for animated window resizing, range 0..1."""
    p = max(0.0, min(1.0, float(progress)))
    return 1.0 - ((1.0 - p) ** 3)


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    try:
        with open(CONFIG_FILE, encoding="utf-8") as f:
            data = json.loads(f.read(65536))
    except FileNotFoundError:
        _write_default_config()
        return cfg
    except (OSError, ValueError):
        logging.warning("Configuration could not be read; using safe defaults")
        return cfg
    if isinstance(data, dict):
        if "resource_profile" not in data:
            cfg["resource_profile"] = "custom"
        for key, val in data.items():
            if key in DEFAULT_CONFIG:
                ok = _cfg_value(key, val)
                if ok is not None:
                    cfg[key] = ok
    return cfg


def notes_storage_dir():
    """Private directory for multiple quick notes."""
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(base, "macos-control-center", "notes")


def _canonical_note_id(note_id=None):
    if note_id in (None, ""):
        return str(uuid.uuid4())
    try:
        return str(uuid.UUID(str(note_id)))
    except (ValueError, TypeError, AttributeError):
        raise ValueError("Ungültige Notiz-ID")


def save_quick_note(note_id, title, text):
    """Persist one note atomically; returns its stable UUID."""
    stable_id = _canonical_note_id(note_id)
    title = str(title or "").strip()[:120] or "Notiz"
    text = str(text or "")
    if len(text.encode("utf-8")) > 1024 * 1024:
        raise ValueError("Notiz ist größer als 1 MiB")
    folder = notes_storage_dir()
    os.makedirs(folder, mode=0o700, exist_ok=True)
    os.chmod(folder, 0o700)
    path = os.path.join(folder, stable_id + ".json")
    payload = {"id": stable_id, "title": title, "text": text,
               "updated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
    fd = None
    tmp = None
    try:
        fd, tmp = tempfile.mkstemp(prefix=".note-", dir=folder)
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            fd = None
            json.dump(payload, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
        os.replace(tmp, path)
        tmp = None
        os.chmod(path, 0o600)
        return stable_id
    finally:
        if fd is not None:
            try: os.close(fd)
            except OSError: pass
        if tmp:
            try: os.unlink(tmp)
            except OSError: pass


def delete_quick_note(note_id):
    stable_id = _canonical_note_id(note_id)
    path = os.path.join(notes_storage_dir(), stable_id + ".json")
    try:
        os.unlink(path)
        return True
    except FileNotFoundError:
        return False


def list_quick_notes():
    """Load saved notes and migrate the old single-note format on first use."""
    folder = notes_storage_dir()
    try:
        os.makedirs(folder, mode=0o700, exist_ok=True)
        os.chmod(folder, 0o700)
    except OSError:
        return []
    entries = []
    for path in glob.glob(os.path.join(folder, "*.json")):
        try:
            if os.path.getsize(path) > 1024 * 1024 + 8192:
                continue
            with open(path, encoding="utf-8") as handle:
                item = json.load(handle)
            stable_id = _canonical_note_id(item.get("id") or os.path.splitext(os.path.basename(path))[0])
            entries.append({"id": stable_id,
                            "title": str(item.get("title") or "Notiz")[:120],
                            "text": str(item.get("text") or ""),
                            "updated_at": str(item.get("updated_at") or "")})
        except (OSError, ValueError, TypeError, UnicodeError):
            continue
    legacy = os.path.join(os.path.dirname(folder), "quick-note.txt")
    if not entries and os.path.isfile(legacy):
        try:
            if os.path.getsize(legacy) <= 1024 * 1024:
                with open(legacy, encoding="utf-8") as handle:
                    legacy_text = handle.read()
                save_quick_note(None, "Importierte Notiz", legacy_text)
                for path in glob.glob(os.path.join(folder, "*.json")):
                    try:
                        with open(path, encoding="utf-8") as handle:
                            item = json.load(handle)
                        entries.append(item)
                    except (OSError, ValueError):
                        pass
        except (OSError, UnicodeError, ValueError):
            pass
    return sorted(entries, key=lambda note: note.get("updated_at", ""), reverse=True)


def _scan_storage(folder, mode="folders", depth=2, limit=100, cancel_event=None, timeout=120):
    """Efficient, bounded storage scan that never traverses another filesystem."""
    folder = os.path.realpath(os.path.expanduser(str(folder)))
    if not os.path.isdir(folder):
        raise ValueError("Ordner existiert nicht")
    if mode not in ("folders", "largest", "types"):
        raise ValueError("Unbekannter Scanmodus")
    depth = max(1, min(8, int(depth)))
    limit = max(1, min(500, int(limit)))
    usage = shutil.disk_usage(folder)
    rows = []
    truncated = False
    warning = ""
    scanned_files = 0
    total_bytes = 0

    if mode == "folders":
        command = ["du", "-x", f"--max-depth={depth}", "-B1", "--null", "--", folder]
        proc = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        started = time.monotonic()
        while True:
            if cancel_event is not None and cancel_event.is_set():
                proc.terminate()
                try: proc.communicate(timeout=2)
                except subprocess.TimeoutExpired: proc.kill(); proc.communicate()
                raise InterruptedError("Scan abgebrochen")
            try:
                output, err = proc.communicate(timeout=0.15)
                break
            except subprocess.TimeoutExpired:
                if time.monotonic() - started > timeout:
                    proc.kill(); proc.communicate()
                    raise TimeoutError("Speicherscan hat das Zeitlimit überschritten")
        if proc.returncode not in (0, 1) and not output:
            raise RuntimeError(os.fsdecode(err).strip() or "du ist fehlgeschlagen")
        if proc.returncode == 1 and err:
            warning = os.fsdecode(err).strip()[:240]
        root_size = 0
        base = os.path.realpath(folder)
        for record in output.split(b"\0"):
            if not record:
                continue
            try:
                raw_size, raw_path = record.split(b"\t", 1)
                size = int(raw_size)
                path = os.path.realpath(os.fsdecode(raw_path))
            except (ValueError, OSError):
                continue
            if path == base:
                root_size = size
                continue
            rel = os.path.relpath(path, base)
            rows.append({"label": rel, "size": size, "path": path,
                         "kind": "folder", "count": 0})
        rows.sort(key=lambda item: item["size"], reverse=True)
        scanned_files = -1  # du reports directory totals, not a file count.
        total_bytes = root_size
        if not root_size:
            total_bytes = sum(item["size"] for item in rows)
    else:
        root_stat = os.stat(folder, follow_symlinks=False)
        root_device = root_stat.st_dev
        deadline = time.monotonic() + max(1, int(timeout))
        max_entries = 300000
        heap = []
        type_totals = {}
        stop = False
        for current, dirs, files in os.walk(folder, topdown=True, followlinks=False):
            if cancel_event is not None and cancel_event.is_set():
                raise InterruptedError("Scan abgebrochen")
            if time.monotonic() > deadline or scanned_files >= max_entries:
                truncated = True
                break
            rel_current = os.path.relpath(current, folder)
            level = 0 if rel_current == "." else rel_current.count(os.sep) + 1
            if level >= depth:
                dirs[:] = []
            safe_dirs = []
            for dirname in dirs:
                dpath = os.path.join(current, dirname)
                try:
                    dst = os.stat(dpath, follow_symlinks=False)
                    if not os.path.islink(dpath) and dst.st_dev == root_device:
                        safe_dirs.append(dirname)
                except OSError:
                    continue
            dirs[:] = safe_dirs
            for filename in files:
                if cancel_event is not None and cancel_event.is_set():
                    raise InterruptedError("Scan abgebrochen")
                if time.monotonic() > deadline or scanned_files >= max_entries:
                    truncated = True
                    stop = True
                    break
                fpath = os.path.join(current, filename)
                try:
                    fst = os.stat(fpath, follow_symlinks=False)
                    if not stat.S_ISREG(fst.st_mode) or fst.st_dev != root_device:
                        continue
                except OSError:
                    continue
                size = max(0, int(fst.st_size))
                scanned_files += 1
                total_bytes += size
                if mode == "largest":
                    item = (size, fpath)
                    if len(heap) < limit:
                        heapq.heappush(heap, item)
                    elif item > heap[0]:
                        heapq.heapreplace(heap, item)
                else:
                    ext = os.path.splitext(filename)[1].lower() or "(ohne Erweiterung)"
                    entry = type_totals.setdefault(ext, {"size": 0, "count": 0})
                    entry["size"] += size
                    entry["count"] += 1
            if stop:
                break
        if mode == "largest":
            rows = [{"label": os.path.relpath(path, folder), "size": size,
                     "path": path, "kind": "file", "count": 1}
                    for size, path in sorted(heap, reverse=True)]
        else:
            rows = [{"label": ext, "size": info["size"], "path": "",
                     "kind": "type", "count": info["count"]}
                    for ext, info in type_totals.items()]
            rows.sort(key=lambda item: item["size"], reverse=True)

    return {"rows": rows[:limit], "used": int(usage.used), "free": int(usage.free),
            "total": int(total_bytes), "files": int(scanned_files),
            "truncated": bool(truncated), "warning": warning, "mode": mode,
            "root": folder}


def _read_hwmon_sensors(hwmon_root="/sys/class/hwmon"):
    """Read fan RPM and temperature sensors, including available thresholds; never writes sysfs."""
    sensors = []
    def read_text(path):
        with open(path, encoding="utf-8") as handle:
            return handle.read().strip()
    def read_number(path, scale=1.0):
        try:
            value = int(read_text(path)) / scale
            return value if -1000 <= value <= 1000000 else None
        except (OSError, ValueError, OverflowError):
            return None
    for hwmon in sorted(glob.glob(os.path.join(hwmon_root, "hwmon*"))):
        try:
            chip = read_text(os.path.join(hwmon, "name")) or os.path.basename(hwmon)
        except OSError:
            chip = os.path.basename(hwmon)
        for kind, pattern, unit, scale in (
            ("fan", "fan*_input", "RPM", 1.0),
            ("temperature", "temp*_input", "°C", 1000.0),
        ):
            for input_path in sorted(glob.glob(os.path.join(hwmon, pattern))):
                stem = input_path[:-6]
                label = chip + " · " + os.path.basename(stem).replace("_", " ")
                try:
                    label_text = read_text(stem + "_label")
                    if label_text:
                        label = chip + " · " + label_text
                except OSError:
                    pass
                value = read_number(input_path, scale)
                if value is None:
                    continue
                minimum = read_number(stem + "_min", scale)
                maximum = read_number(stem + "_max", scale)
                critical = read_number(stem + "_crit", scale) if kind == "temperature" else None
                sensors.append({"key": input_path, "chip": chip, "name": label,
                                "kind": kind, "value": value, "unit": unit,
                                "minimum": minimum, "maximum": maximum,
                                "critical": critical, "path": input_path})
    return sensors


