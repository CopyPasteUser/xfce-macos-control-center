        state = {"cancel": None, "pulse_id": 0, "result": None, "rows": [], "folder": ""}

        def selected_row():
            model, itr = view.get_selection().get_selected()
            return model, itr

        def selection_changed(*_args):
            model, itr = selected_row()
            path = model.get_value(itr, 3) if itr else ""
            open_button.set_sensitive(bool(path and os.path.exists(path)))
            copy_button.set_sensitive(bool(path))

        view.get_selection().connect("changed", selection_changed)

        def stop_pulse():
            ident = state.get("pulse_id", 0)
            if ident:
                try: GLib.source_remove(ident)
                except Exception: pass
                state["pulse_id"] = 0

        def pulse():
            if state.get("cancel") is None:
                state["pulse_id"] = 0
                return False
            progress.pulse()
            return True

        def scan_done(result, error):
            stop_pulse()
            progress.set_fraction(0)
            progress.hide()
            scan_button.set_sensitive(True)
            cancel_button.set_sensitive(False)
            state["cancel"] = None
            if error:
                summary.set_text(T("storage_cancelled") if error == "__cancelled__"
                                 else T("storage_error") + ": " + str(error)[:180])
                state["result"] = None
                state["rows"] = []
                store.clear()
                selection_changed()
                return False

            store.clear()
            data_rows = result.get("rows", [])
            total = max(1, int(result.get("total", 0)))
            for item in data_rows:
                size = int(item.get("size", 0))
                percent = max(0.0, min(100.0, size * 100.0 / total))
                store.append((item.get("label", ""), self._format_bytes(size),
                              f"{percent:.1f}%", item.get("path", ""), size))
            state["result"] = result
            state["rows"] = data_rows
            headline = T("storage_total", used=self._format_bytes(result.get("used", 0)),
                         free=self._format_bytes(result.get("free", 0)))
            extra = T("storage_scan_summary", count=max(0, result.get("files", 0)),
                      size=self._format_bytes(result.get("total", 0)))
            if result.get("files", 0) < 0:
                extra = T("storage_depth_result", size=self._format_bytes(result.get("total", 0)))
            if result.get("truncated"):
                extra += " · " + T("storage_truncated")
            if result.get("warning"):
                extra += " · " + str(result["warning"])[:120]
            summary.set_text(headline + "\n" + extra)
            selection_changed()
            if not data_rows:
                store.append((T("storage_empty"), "", "", "", 0))
            return False

        def begin_scan(*_args):
            folder = chooser.get_filename()
            if not folder or not os.path.isdir(folder):
                summary.set_text(T("storage_error"))
                return
            cancel_event = threading.Event()
            state["cancel"] = cancel_event
            state["folder"] = folder
            scan_mode = mode.get_active_id() or "folders"
            scan_depth = int(depth.get_active_id() or "2")
            store.clear()
            scan_button.set_sensitive(False)
            cancel_button.set_sensitive(True)
            progress.show()
            progress.set_fraction(0)
            summary.set_text(T("storage_scanning"))
            if not state.get("pulse_id"):
                state["pulse_id"] = GLib.timeout_add(120, pulse)
            threading.Thread(target=self._storage_worker,
                args=(folder, scan_mode, scan_depth, cancel_event, scan_done), daemon=True).start()

        def cancel_scan(*_args):
            event = state.get("cancel")
            if event is not None:
                event.set()
                cancel_button.set_sensitive(False)
                summary.set_text(T("storage_cancelling"))

        def open_selected(*_args):
            model, itr = selected_row()
            path = model.get_value(itr, 3) if itr else ""
            if path and os.path.exists(path) and which("xdg-open"):
                try:
                    subprocess.Popen(["xdg-open", path], stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                except OSError:
                    self._toast(T("launch_error"), error=True)

        def copy_selected(*_args):
            model, itr = selected_row()
            path = model.get_value(itr, 3) if itr else ""
            if path:
                Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(path, -1)
                self._toast(T("diagnostics_copied"), timeout_ms=1200)

        def export_csv(*_args):
            result = state.get("result")
            if not result:
                self._toast(T("storage_empty"), error=True)
                return
            save_dialog = Gtk.FileChooserDialog(title=T("storage_export_csv"), transient_for=dialog,
                action=Gtk.FileChooserAction.SAVE)
            save_dialog.add_button(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL)
            save_dialog.add_button(Gtk.STOCK_SAVE, Gtk.ResponseType.ACCEPT)
            save_dialog.set_current_name("storage-analysis.csv")
            if save_dialog.run() == Gtk.ResponseType.ACCEPT:
                target = save_dialog.get_filename()
                try:
                    with open(target, "w", encoding="utf-8", newline="") as handle:
                        writer = csv.writer(handle)
                        writer.writerow(["Name", "Bytes", "Path", "Type", "Count"])
                        for item in result.get("rows", []):
                            writer.writerow([item.get("label", ""), item.get("size", 0),
                                             item.get("path", ""), item.get("kind", ""), item.get("count", 0)])
                    self._toast(T("storage_exported"))
                except OSError:
                    self._toast(T("settings_failed"), error=True)
            save_dialog.destroy()

        scan_button.connect("clicked", begin_scan)
        cancel_button.connect("clicked", cancel_scan)
        open_button.connect("clicked", open_selected)
        copy_button.connect("clicked", copy_selected)
        export_button.connect("clicked", export_csv)
        dialog.connect("response", lambda *_: state["cancel"].set() if state.get("cancel") else None)
        dialog.show_all()
        progress.hide()
        dialog.run()
        if state.get("cancel"):
            state["cancel"].set()
        stop_pulse()
        dialog.destroy()

    def _storage_worker(self, folder, mode, depth, cancel_event, done_callback):
        try:
            result = _scan_storage(folder, mode, depth, limit=150, cancel_event=cancel_event)
            error = "__cancelled__" if cancel_event.is_set() else None
        except InterruptedError:
            result, error = None, "__cancelled__"
        except (OSError, RuntimeError, ValueError, TimeoutError) as exc:
            result, error = None, str(exc) or T("storage_error")
        GLib.idle_add(done_callback, result, error)
        return False

