def media_info():
    # Player-Titel, Interpret, Status und optionales MPRIS-Cover (lokal oder URL).
    st = shc("playerctl", "status")
    if st not in ("Playing", "Paused"):
        return None
    meta = shc("playerctl", "metadata", "--format", "{{title}}\t{{artist}}\t{{mpris:artUrl}}\t{{mpris:length}}")
    parts = meta.split("\t", 3)
    title = parts[0].strip() or T("media_default")
    artist = parts[1].strip() if len(parts) > 1 else ""
    art_url = parts[2].strip() if len(parts) > 2 else ""
    try:
        duration = max(0.0, float(parts[3]) / 1_000_000.0) if len(parts) > 3 and parts[3] else 0.0
    except ValueError:
        duration = 0.0
    try:
        position = max(0.0, float(shc("playerctl", "position", timeout=1)))
    except ValueError:
        position = 0.0
    return title, artist, st == "Playing", art_url, position, duration


