    _DETAIL_HEAD = {"wifi": T("head_wifi"), "bt": T("head_bt"), "vpn": T("head_vpn")}

    def _navigate_page(self, page):
        if getattr(self, "_pw_active", False):
            self._pw_close()
        self._detail_generation = getattr(self, "_detail_generation", 0) + 1
        self._current_page = page
        self._content_stack.set_visible_child_name(page)
        self._schedule_dynamic_resize(45)
        return False

    def _detail_toggle(self, mode):
        if mode == "sound":
            self._navigate_page("sound")
            return
        if mode == "network":
            self._detail_mode = mode
            for child in self._network_list.get_children():
                self._network_list.remove(child)
            self._network_list.pack_start(Gtk.Label(label=T("loading"), xalign=0), False, False, 0)
            self._network_list.show_all()
            self._navigate_page("network")
            self._detail_reload()
            return
        self._detail_mode = mode
        self._detail_head.set_text(self._DETAIL_HEAD[mode])
        self._detail_set_msg(T("loading"))
        self._navigate_page("detail")
        self._schedule_dynamic_resize(185)
        self._detail_reload()

    def _detail_reload(self):
        if not self._detail_mode or self._destroyed or self._current_page not in ("detail", "network"):
            return
        if not hasattr(self, "_detail_jobs"):
            self._detail_jobs = set()
        if self._detail_mode in self._detail_jobs:
            return
        self._detail_generation = getattr(self, "_detail_generation", 0) + 1
        self._detail_jobs.add(self._detail_mode)
        threading.Thread(target=self._detail_worker,
                         args=(self._detail_mode, self._detail_generation), daemon=True).start()

    def _detail_worker(self, mode, generation):
        try:
            if mode == "wifi":
                if wifi_on():
                    # Bound and reap the scan process; cached networks still work
                    # when scanning is denied or another scan is in progress.
                    try:
                        _command_result(["nmcli", "dev", "wifi", "rescan"], timeout=5)
                    except (OSError, subprocess.TimeoutExpired):
                        pass
                    networks = wifi_list()
                    data = {"summary": wifi_connection_summary(networks), "networks": networks}
                else:
                    data = "off"
            elif mode == "bt":
                data = bt_devices() if bt_on() else "off"
            elif mode == "network":
                data = wifi_connection_summary(wifi_list()) if wifi_on() else "off"
            else:
                names, act = vpn_state()
                data = [(n, n == act) for n in names]
        except Exception:
            logging.exception("Detail discovery failed: %s", mode)
            data = []
        GLib.idle_add(self._detail_complete, mode, generation, data)

    def _detail_complete(self, mode, generation, data):
        self._detail_jobs.discard(mode)
        if self._destroyed:
            return False
        visible = self._current_page == ("network" if mode == "network" else "detail")
        if mode != self._detail_mode or not visible:
            return False
        if generation != self._detail_generation:
            self._detail_reload()
            return False
        return self._detail_fill(mode, data)

    def _detail_clear(self):
        for c in self._detail_list.get_children():
            self._detail_list.remove(c)

