        if "Device Enabled" in line:
            return line.rsplit(":", 1)[-1].strip() == "1"
    return None


def input_set(name, on):
    subprocess.run(["xinput", "enable" if on else "disable", name], capture_output=True, timeout=4)


def screen_rotation():
    for line in shc("xrandr", "--query").splitlines():
        if " connected" in line:
            toks = line.split()
            rot = "normal"
            for i, t in enumerate(toks):
                if t.startswith("("):
                    if i > 0 and toks[i - 1] in ("left", "right", "inverted"):
                        rot = toks[i - 1]
                    break
            return toks[0], rot
    return None, "normal"


ROT_NEXT = {"normal": "right", "right": "inverted", "inverted": "left", "left": "normal"}
ROT_LABEL = {"normal": "0°", "right": "90°", "inverted": "180°", "left": "270°"}
ROT_MATRIX = {"normal": "1 0 0 0 1 0 0 0 1", "left": "0 -1 1 1 0 0 0 0 1",
              "right": "0 1 0 -1 0 1 0 0 1", "inverted": "-1 0 1 0 -1 1 0 0 1"}
ROT_WACOM = {"normal": "none", "left": "ccw", "right": "cw", "inverted": "half"}


def rotate_screen(out, rot):
    subprocess.run(["xrandr", "--output", out, "--rotate", rot], capture_output=True, timeout=8)
    names = [l.strip() for l in shc("xinput", "list", "--name-only").splitlines()
             if "wacom" in l.lower()]
    for n in names:
        if which("xsetwacom"):
            subprocess.run(["xsetwacom", "set", n, "Rotate", ROT_WACOM[rot]],
                           capture_output=True, timeout=4)
        else:
            subprocess.run(["xinput", "set-prop", n, "Coordinate Transformation Matrix"]
                           + ROT_MATRIX[rot].split(), capture_output=True, timeout=4)


def discover_tiles():
    # Independent optional services: failure of one probe cannot suppress others.
    def inputs():
        names = [line.strip() for line in shc("xinput", "list", "--name-only").splitlines()]
        touch = next((n for n in names if ("touchscreen" in n.lower() or "finger" in n.lower())
                      and "touchpad" not in n.lower()), None)
        pad = next((n for n in names if "touchpad" in n.lower()), None)
        return {"touch": touch, "tpad": pad}

    def power():
        cur, profiles = pp_state()
        return {"pp": (cur, profiles)} if profiles else {}

    def rotation():
        out, angle = screen_rotation()
        return {"rot": (out, angle)} if out else {}

    jobs = []
    for enabled, func in ((which("gdbus") or which("powerprofilesctl"), power),
                          (which("xinput"), inputs), (which("xrandr"), rotation),
                          (which("xfconf-query"), lambda: {"dnd": notification_dnd_state()})):
        if enabled:
            jobs.append(func)
    info = {"osk": bool(which("onboard"))}
    workers = _resource_policy(CFG.get("resource_profile", "balanced"))[1]
    with ThreadPoolExecutor(max_workers=workers, thread_name_prefix="cc-discover") as pool:
        for future in as_completed([pool.submit(job) for job in jobs]):
            try:
                info.update(future.result())
            except Exception:
                pass
    return info


