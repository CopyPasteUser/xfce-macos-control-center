    def _available_popup_height(self):
        """Usable vertical space below the panel on the active primary monitor."""
        display = Gdk.Display.get_default()
        if display is None:
            return 640
        mon = display.get_primary_monitor()
        if mon is None and display.get_n_monitors() > 0:
            mon = display.get_monitor(0)
        if mon is None:
            return 640
        geo = mon.get_geometry()
        try:
            work = mon.get_workarea()
        except (AttributeError, TypeError):
            work = geo
        popup_top = max(geo.y + 46, work.y)
        work_bottom = work.y + work.height
        usable = min(geo.height - 58, work_bottom - popup_top - 12)
        return max(1, int(usable))

    def _natural_content_height(self):
        try:
            _minimum, natural = self._content_root.get_preferred_height()
            return max(1, int(natural))
        except Exception:
            return 320

    def _initialize_dynamic_size(self):
        """Set a correct initial size before the popup is first presented."""
        available = self._available_popup_height()
        target = _adaptive_height(self._natural_content_height(), available)
        self._available_height = available
        self._content_scroll.set_size_request(-1, target)
        self.set_default_size(330, target)
        return False

    def _place(self):
        display = Gdk.Display.get_default()
        if display is None:
            return
        mon = display.get_primary_monitor()
        if mon is None and display.get_n_monitors() > 0:
            mon = display.get_monitor(0)
        if mon is None:
            return
        geo = mon.get_geometry()
        self.realize()
        width = self.get_size().width or 330
        x = max(geo.x + 6, geo.x + geo.width - width - 10)
        y = geo.y + 46
        self.move(x, y)

    def _on_alloc(self, w, rect):
        # Breitenänderungen verankern das Popup weiterhin am rechten Bildschirmrand.
        if rect.width != self._anchor_w:
            self._anchor_w = rect.width
            GLib.idle_add(self._reanchor)

    def _on_map_position(self, *args):
        GLib.idle_add(self._reanchor)
        self._schedule_dynamic_resize(40)
        return False

    def _on_screen_size_changed(self, *args):
        GLib.idle_add(self._reanchor)
        self._schedule_dynamic_resize(60)
        return False

    def _reanchor(self):
        display = Gdk.Display.get_default()
        if display is None:
            return False
        mon = display.get_primary_monitor()
        if mon is None and display.get_n_monitors() > 0:
            mon = display.get_monitor(0)
        if mon is None:
            return False
        geo = mon.get_geometry()
        width = self.get_allocation().width or self.get_size()[0] or 330
        x = max(geo.x + 6, geo.x + geo.width - width - 10)
        y = geo.y + 46
        current_x, current_y = self.get_position()
        if (current_x, current_y) != (x, y):
            self.move(x, y)
        return False

    def _schedule_dynamic_resize(self, delay=185):
        """Debounce child-layout changes, then smoothly resize to natural height."""
        if self._resize_debounce_id:
            try:
                GLib.source_remove(self._resize_debounce_id)
            except Exception:
                pass
            self._resize_debounce_id = 0
        self._resize_debounce_id = GLib.timeout_add(max(1, int(delay)), self._begin_dynamic_resize)
        return False

    def _begin_dynamic_resize(self):
        self._resize_debounce_id = 0
        if not hasattr(self, "_content_scroll"):
            return False
        available = self._available_popup_height()
        self._available_height = available
        target = _adaptive_height(self._natural_content_height(), available)
        width = self.get_size()[0] or 330
        current = self._content_scroll.get_allocation().height or self.get_size()[1] or target

        if self._resize_anim_id:
            try:
                GLib.source_remove(self._resize_anim_id)
            except Exception:
                pass
            self._resize_anim_id = 0
            self._resize_anim_data = None

        if not self.get_realized() or not self.get_visible():
            self._content_scroll.set_size_request(-1, target)
            self.set_default_size(width, target)
            if self.get_realized():
                self.resize(width, target)
            return False

        if CFG.get("reduce_motion", False) or CFG.get("animation_speed", "smooth") == "off" or abs(int(current) - target) <= 3:
            self._content_scroll.set_size_request(-1, target)
            if abs(int(current) - target) > 3:
                self.resize(width, target)
            self._reanchor()
            return False

        self._resize_anim_data = {
            "start": int(current), "target": target, "width": width,
            "started": GLib.get_monotonic_time(), "duration": 190000,
        }
        self._resize_anim_id = GLib.timeout_add(16, self._resize_step)
        return False

    def _resize_step(self):
        data = self._resize_anim_data
        if not data:
            self._resize_anim_id = 0
            return False
        if not self.get_visible():
            self._content_scroll.set_size_request(-1, data["target"])
            self._resize_anim_id = 0
            self._resize_anim_data = None
            return False
        elapsed = max(0, GLib.get_monotonic_time() - data["started"])
        progress = min(1.0, elapsed / float(data["duration"]))
        eased = _ease_out_cubic(progress)
        height = round(data["start"] + (data["target"] - data["start"]) * eased)
        height = max(1, height)
        self._content_scroll.set_size_request(-1, height)
        self.resize(data["width"], height)
        if progress >= 1.0:
            self._content_scroll.set_size_request(-1, data["target"])
            self.resize(data["width"], data["target"])
            self._resize_anim_id = 0
            self._resize_anim_data = None
            self._reanchor()
            return False
        return True

    def _shrink(self):
        # Legacy callers now request a natural-height recomputation rather than resize(width, 1).
        self._schedule_dynamic_resize(0)
        return False

    def _flip(self, holder, on):
        button = holder[1]
        ctx = button.get_style_context()
        ctx.add_class("on") if on else ctx.remove_class("on")
        icon_name = getattr(self, "_toggle_icons", {}).get(id(button))
        if icon_name:
            image = svg_image(icon_name, size=UI_TOKENS["icon_action"],
                              color=(ACCENT if on else _inactive_icon_color()))
            button.set_image(image)
            image.show()

    def _toast(self, message, error=False, timeout_ms=2600):
        if not error and not CFG.get("feedback", True):
            return
        if not hasattr(self, "_toast_label"):
            return
        if self._toast_src:
            try:
                GLib.source_remove(self._toast_src)
            except Exception:
                pass
            self._toast_src = 0
        self._toast_label.set_text(str(message))
        context = self._toast_box.get_style_context()
        if error:
            context.add_class("error")
        else:
            context.remove_class("error")
        self._toast_revealer.set_transition_duration(self._animation_duration(120))
        self._toast_revealer.set_reveal_child(True)
        self._schedule_dynamic_resize(150)
        self._toast_src = GLib.timeout_add(int(timeout_ms), self._hide_toast)

    def _hide_toast(self):
        self._toast_src = 0
        if hasattr(self, "_toast_revealer"):
            self._toast_revealer.set_reveal_child(False)
            self._schedule_dynamic_resize(180)
        return False

    def _launch(self, argv):
        # Erst starten (losgelöst), dann Control Center schließen
        try:
            subprocess.Popen(argv, start_new_session=True,
                             stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        except OSError:
            self._toast(T("launch_error"), error=True)
            return
        self._dismiss()

    def _publish_runtime_state(self):
        callback = getattr(self, "_runtime_state_callback", None)
        if callback:
            try:
                callback()
            except Exception:
                pass

    def _cancel_focus_hide(self):
        source_id = getattr(self, "_focus_hide_src", 0)
        self._focus_hide_src = 0
        if source_id:
            try:
                GLib.source_remove(source_id)
            except Exception:
                pass
        return False

    def _dismiss(self):
        self._visibility_generation += 1
        self._cancel_focus_hide()
        if self._resident:
            self.hide()
            self._publish_runtime_state()
        else:
            self.close()

    def _on_focus_out(self, *args):
        if getattr(self, "_workspace_dialog", None) is not None:
            return False
        if CFG.get("stay_open", False):
            return False
        if not self._resident:
            self.close()
            return False

        # Opening can trigger a transient focus-out while the WM is still
        # transferring focus from the panel. Defer the check until the grace
        # interval expires instead of closing immediately or dropping the event.
        self._cancel_focus_hide()
        generation = self._visibility_generation
        remaining = self._focus_guard_until - time.monotonic()
        # The panel launcher validates runtime metadata before sending an explicit
        # show/hide signal. Give it time to arrive before focus-out auto-hide fires.
        delay_ms = max(650, int(remaining * 1000) + 100) if remaining > 0 else 650
        self._focus_hide_src = GLib.timeout_add(
            delay_ms, self._hide_after_focus_check, generation
        )
        return False

    def _hide_after_focus_check(self, generation=None):
        self._focus_hide_src = 0
        if getattr(self, "_workspace_dialog", None) is not None:
            return False
        if generation is not None and generation != self._visibility_generation:
            return False
        if (self._resident and not CFG.get("stay_open", False)
                and self.get_visible()):
            # If another show/toggle happened during the grace period, don't
            # let an obsolete focus event close the newly opened popup.
            remaining = self._focus_guard_until - time.monotonic()
            if remaining > 0:
                self._focus_hide_src = GLib.timeout_add(
                    max(25, int(remaining * 1000) + 25),
                    self._hide_after_focus_check, self._visibility_generation
                )
                return False
            try:
                window = self.get_window()
                focused = bool(window and window.has_toplevel_focus())
                if not focused:
                    focused = bool(self.is_active())
            except Exception:
                focused = False
            if not focused:
                self.hide()
                self._publish_runtime_state()
        return False

    def _force_show(self):
        """Idempotently show the existing resident window (SIGUSR1)."""
        self._visibility_generation += 1
        self._cancel_focus_hide()
        self._focus_guard_until = time.monotonic() + 0.75
        if not self.get_visible():
            self.show_all()
        self.set_keep_above(True)
        self.present()
        self.grab_focus()
        self._schedule_dynamic_resize(25)
        self._tick_once()
        self._publish_runtime_state()
        return False

    def _force_hide(self):
        """Idempotently hide the existing resident window (SIGUSR2)."""
        self._visibility_generation += 1
        self._cancel_focus_hide()
        if self.get_visible():
            self.hide()
        self._publish_runtime_state()
        return False

    def _toggle_visibility(self):
        # Kept for internal/compatibility callers. The panel starter uses the
        # explicit show/hide signals below to avoid a focus-out race.
        if self.get_visible():
            return self._force_hide()
        return self._force_show()

    def on_key(self, w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self._dismiss()
            return True
        ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        if ctrl and ev.keyval in (Gdk.KEY_f, Gdk.KEY_F):
            self._action_search.grab_focus()
            return True
        if ctrl and ev.keyval in (Gdk.KEY_r, Gdk.KEY_R):
            self._manual_refresh()
            return True
        if ctrl and ev.keyval in (Gdk.KEY_q, Gdk.KEY_Q):
            self._dismiss()
            return True
        if ctrl and ev.keyval == Gdk.KEY_comma:
            self._act_toggle("settings")
            return True
        if ev.keyval in (Gdk.KEY_Page_Down, Gdk.KEY_Page_Up, Gdk.KEY_Home, Gdk.KEY_End):
            adj = self._content_scroll.get_vadjustment()
            low = adj.get_lower()
            high = max(low, adj.get_upper() - adj.get_page_size())
            if ev.keyval == Gdk.KEY_Page_Down:
                value = adj.get_value() + max(40, adj.get_page_size() * 0.80)
            elif ev.keyval == Gdk.KEY_Page_Up:
                value = adj.get_value() - max(40, adj.get_page_size() * 0.80)
            elif ev.keyval == Gdk.KEY_Home:
                value = low
            else:
                value = high
            adj.set_value(max(low, min(high, value)))
            return True
        return False

    # ── Hilfen für Live-Aktualisierung ──
    def _chg(self, key, val, busy_key=None):
        # True, wenn sich der Wert seit dem letzten Anwenden geändert hat.
        # Während einer Aktion (busy) wird nichts überschrieben.
        if self._busy.get(busy_key or key):
            return False
        if self._last.get(key) == val:
            return False
        self._last[key] = val
        return True

    def _busy_for(self, key, ms):
        self._busy[key] = True
        self._last.pop(key, None)
        GLib.timeout_add(ms, self._free, key)

    def _free(self, key):
        self._busy[key] = False
        self._last.pop(key, None)
        self._tick()               # sofort neu einlesen, falls die Aktion nicht geklappt hat
        return False

    def _hold_sliders(self):
        # Nach Bedienung die Regler 2 s nicht von der Live-Aktualisierung überschreiben
        self._hold = GLib.get_monotonic_time() + 2000000

    def _debounced(self, key, fn, *args):
        old = self._deb.pop(key, None)
        if old:
            GLib.source_remove(old[0])
        src = GLib.timeout_add(100, self._deb_run, key)
        self._deb[key] = (src, fn, args)

    def _deb_run(self, key):
        item = self._deb.pop(key, None)
        if item:
            item[1](*item[2])
        return False

    # ══════════════════ Wi-Fi / Bluetooth / Night Shift ══════════════════
    def on_wifi(self, b):
        if "wifi" not in self._st:
            self._tick_once()
            self._toast(T("working"))
            return
        on = not self._st["wifi"]
        subprocess.Popen(["nmcli", "radio", "wifi", "on" if on else "off"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self._st["wifi"] = on
        self._flip(self.btn_wifi, on)
        self.btn_wifi[2].set_text(T("on") if on else T("off"))
        self._busy_for("wifi", 2500)

    def on_bt(self, b):
        if self._bt_pending:
            return
        self._bt_pending = True
        self._bt_generation += 1
        generation = self._bt_generation
        target = not self._st.get("bt", False)
        self.btn_bt[0].set_sensitive(False)
        self.btn_bt[2].set_text(T("connecting"))
        threading.Thread(target=self._bt_worker, args=(generation, target), daemon=True).start()

    def _bt_worker(self, generation, target):
        try:
            result = bluetooth_set_power(target)
        except Exception:
            logging.exception("Bluetooth power worker failed")
            result = {"status": "error", "powered": None}
        GLib.idle_add(self._bt_apply_result, generation, target, result)

    def _bt_apply_result(self, generation, target, result):
        if generation != self._bt_generation or self._destroyed:
            return False
        self._bt_pending = False
        self._bt_generation += 1  # invalidate polls begun while the action was running
        state = result.get("powered")
        self._bt_last_status = result.get("status", "error")
        status = result.get("status")
        if state is not None:
            self._st["bt"] = state
            self._flip(self.btn_bt, state)
            self.btn_bt[2].set_text(T("on") if state else T("off"))
        else:
            self.btn_bt[2].set_text(T("on") if self._st.get("bt", False) else T("off"))
        self.btn_bt[0].set_sensitive(bool(which("bluetoothctl")))
        if status == "ready" and state is target:
            self._toast(T("on") if target else T("off"), timeout_ms=1100)
        else:
            message = {"adapter_unavailable": "bt_adapter_missing", "blocked": "bt_blocked",
                       "permission": "bt_permission", "service": "bt_service",
                       "timeout": "bt_timeout"}.get(status, "bt_power_error")
            self._toast(T(message), error=True)
        return False

    def on_nightshift(self, b):
        if not which("gammastep") or self._busy.get("ns"):
            return
        self._busy["ns"] = True
        threading.Thread(target=self._nightshift_worker, daemon=True).start()

    def _nightshift_worker(self):
        actual = None
        try:
            if nightshift_on():
                _command_result(["pkill", "-x", "gammastep"], timeout=2)
                _command_result(["gammastep", "-x"], timeout=3)
            else:
                subprocess.Popen(["gammastep"], start_new_session=True, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            actual = nightshift_on()
        except (OSError, subprocess.TimeoutExpired):
            logging.warning("Night Shift command failed or timed out")
        GLib.idle_add(self._nightshift_done, actual)

    def _nightshift_done(self, actual):
        if self._destroyed:
            return False
        self._busy["ns"] = False
        if actual is None:
            self._toast(T("settings_failed"), error=True)
        else:
            self._st["ns"] = actual
            self._flip(self.btn_ns, actual)
            self.btn_ns[2].set_text(T("active") if actual else T("off"))
        return False

    # ══════════════════ VPN ══════════════════
    def _vpn_apply(self, v):
        names, act = v
        self._vpn_names, self._vpn_active, self._vpn_known = list(names), act, True
        self._flip(self.btn_vpn, bool(act))
        if act:
            self.btn_vpn[2].set_text(T("connected"))
            self.btn_vpn[1].set_tooltip_text(f"VPN: {act}")
        else:
            self.btn_vpn[2].set_text(T("off") if names else T("no_profile"))
            self.btn_vpn[1].set_tooltip_text(None)

    def on_vpn(self, b):
        if self._busy.get("vpn"):
            return
        if self._vpn_active:
            self._vpn_run(self._vpn_active, True)
        elif VPN_PREFERRED in self._vpn_names:
            self._vpn_run(VPN_PREFERRED, False)
        elif not self._vpn_known or len(self._vpn_names) > 1:
            self._detail_toggle("vpn")      # Profil auswählen
        elif len(self._vpn_names) == 1:
            self._vpn_run(self._vpn_names[0], False)

    def _vpn_run(self, target, disconnect):
        if self._busy.get("vpn"):
            return
        self._busy["vpn"] = True
        self._last.pop("vpn", None)
        self.btn_vpn[2].set_text(T("disconnecting") if disconnect else T("connecting"))
        threading.Thread(target=self._vpn_worker,
                         args=(target, self._vpn_active, disconnect), daemon=True).start()

    def _vpn_worker(self, target, current, disconnect):
        ok = True
        try:
            if disconnect:
                if current:
                    r = subprocess.run(
                        ["nmcli", "-w", "20", "connection", "down", "id", current],
                        capture_output=True, timeout=25)
                    ok = r.returncode == 0
            else:
                if current and current != target:
                    r = subprocess.run(
                        ["nmcli", "-w", "20", "connection", "down", "id", current],
                        capture_output=True, timeout=25)
                    ok = r.returncode == 0
                if ok:
                    r = subprocess.run(
                        ["nmcli", "-w", "20", "connection", "up", "id", target],
                        capture_output=True, timeout=25)
                    ok = r.returncode == 0
        except Exception:
            ok = False
        GLib.idle_add(self._vpn_done, vpn_state(), ok)

    def _vpn_done(self, v, ok=True):
        if self._destroyed:
            return False
        self._busy["vpn"] = False
        self._last.pop("vpn", None)
        self._vpn_apply(v)
        if not ok:
            self.btn_vpn[2].set_text(T("failed"))
            if self._detail_mode == "vpn":
                self._detail_set_msg(T("vpn_error"))
                GLib.timeout_add(3500, self._detail_reload_once)
        elif self._detail_mode == "vpn":
            self._detail_reload()
        return False

