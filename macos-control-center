        title_entry.get_accessible().set_name(T("notes_title"))
        content.pack_start(title_entry, False, False, 0)

        view = Gtk.TextView()
        view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        view.set_left_margin(9)
        view.set_right_margin(9)
        view.set_top_margin(8)
        view.set_bottom_margin(8)
        view.get_accessible().set_name(T("quick_notes"))
        view.get_style_context().add_class("notes-editor")
