    def _set_media(self, info):
        box = self._media_box
        if box is None:
            return
        hidden = not CFG.get("media_card", True) or (info is None and CFG.get("media_hide_idle", False))
        was_visible = box.get_visible()
        box.set_no_show_all(hidden)
        if hidden:
            box.hide()
            if was_visible:
                self._schedule_dynamic_resize(185)
            return
        box.show()
        if not was_visible:
            self._schedule_dynamic_resize(185)
        if info is None:
            had_progress = self._m_progress_row.get_visible()
            self._m_title.set_text(T("media_idle"))
            self._m_artist.set_text(T("media_idle_help"))
            self._m_time.set_text("")
            self._m_progress.set_fraction(0.0)
            self._m_progress_row.hide()
            self._m_play_img.set_from_icon_name("media-playback-start-symbolic", Gtk.IconSize.MENU)
            for button in self._media_controls:
                button.set_sensitive(False)
            self._m_art_url = None
            self._m_art_generation += 1
            self._reset_media_cover()
            if had_progress:
                self._schedule_dynamic_resize(185)
            return
        title, artist, playing = info[:3]
        was_idle = self._m_progress_row.get_visible() != CFG.get("media_progress", True)
        self._m_progress_row.set_visible(CFG.get("media_progress", True))
        for button in self._media_controls:
            button.set_sensitive(True)
        art_url = info[3] if len(info) > 3 else ""
        position = info[4] if len(info) > 4 else None
        duration = info[5] if len(info) > 5 else None
        self._m_title.set_text(title)
        self._m_artist.set_text(artist)
        if duration and duration > 0:
            self._m_progress.set_fraction(max(0.0, min(1.0, (position or 0.0) / duration)))
            self._m_time.set_text(f"{self._format_media_time(position or 0)} / {self._format_media_time(duration)}")
        else:
            self._m_progress.set_fraction(0.0)
            self._m_time.set_text("")
        self._m_play_img.set_from_icon_name(
            "media-playback-pause-symbolic" if playing else "media-playback-start-symbolic",
            Gtk.IconSize.MENU)
        if CFG.get("media_thumbnail", True) and art_url != self._m_art_url:
            self._m_art_url = art_url
            self._m_art_generation += 1
            generation = self._m_art_generation
            self._reset_media_cover()
            if art_url:
                threading.Thread(target=self._media_cover_worker,
                                 args=(art_url, generation), daemon=True).start()
        elif not CFG.get("media_thumbnail", True):
            self._m_art_url = None
            self._m_art_generation += 1
            self._reset_media_cover()
        if was_idle:
            self._schedule_dynamic_resize(185)

    @staticmethod
    def _format_media_time(seconds):
        total = max(0, int(seconds or 0))
        hours, remainder = divmod(total, 3600)
        minutes, secs = divmod(remainder, 60)
        return f"{hours}:{minutes:02d}:{secs:02d}" if hours else f"{minutes}:{secs:02d}"

    def _reset_media_cover(self):
        if getattr(self, "_m_cover", None) is not None:
            self._m_cover.set_from_icon_name("video-x-generic-symbolic", Gtk.IconSize.DIALOG)

    def _media_cover_worker(self, url, generation):
        pixbuf = None
        try:
            from gi.repository import GdkPixbuf
            parsed = urllib.parse.urlparse(url)
            if parsed.scheme == "file":
                path = urllib.request.url2pathname(parsed.path)
                if os.path.getsize(path) <= 4 * 1024 * 1024:
                    with open(path, "rb") as f:
                        data = f.read(4 * 1024 * 1024 + 1)
                else:
                    data = b""
            elif parsed.scheme in ("http", "https"):
                request = urllib.request.Request(url, headers={"User-Agent": "macos-control-center/1.3.1"})
                with urllib.request.urlopen(request, timeout=2.0) as response:
                    data = response.read(4 * 1024 * 1024 + 1)
            elif not parsed.scheme and os.path.isfile(url) and os.path.getsize(url) <= 4 * 1024 * 1024:
                with open(url, "rb") as f:
                    data = f.read(4 * 1024 * 1024 + 1)
            else:
                data = b""
            if data and len(data) <= 4 * 1024 * 1024:
                loader = GdkPixbuf.PixbufLoader.new()
                loader.set_size(56, 56)
                loader.write(data)
                loader.close()
                decoded = loader.get_pixbuf()
                if decoded is not None:
                    # Preserve image proportions and center-crop to square artwork.
                    target_w, target_h = 56, 56
                    ratio = max(target_w / decoded.get_width(), target_h / decoded.get_height())
                    scaled = decoded.scale_simple(
                        max(target_w, int(decoded.get_width() * ratio)),
                        max(target_h, int(decoded.get_height() * ratio)),
                        GdkPixbuf.InterpType.BILINEAR)
                    x = max(0, (scaled.get_width() - target_w) // 2)
                    y = max(0, (scaled.get_height() - target_h) // 2)
                    pixbuf = scaled.new_subpixbuf(x, y, target_w, target_h).copy()
        except Exception:
            pixbuf = None
        GLib.idle_add(self._media_cover_done, generation, pixbuf)

    def _media_cover_done(self, generation, pixbuf):
        if self._destroyed or generation != self._m_art_generation or not getattr(self, "_m_cover", None):
            return False
        if pixbuf is not None:
            self._m_cover.set_from_pixbuf(pixbuf)
            self._m_cover.set_pixel_size(44)
        return False

