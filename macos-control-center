#root .knob:hover {{ background-color: {tokens['hover']}; }}
#root .knob:active {{ background-color: {tokens['pressed']}; }}
#root .knob.on, #root .knob.on:hover, #root .knob.on:active, #root .selected-category {{ background-color: {tokens['active_surface']}; border-color: {hex_color}; }}
