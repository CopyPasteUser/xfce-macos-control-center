def _accent_for_theme(theme, accent_color):
    color, rgb = ACCENT_PALETTE.get(accent_color, ACCENT_PALETTE["blue"])
    if theme != "light":
        return color, rgb
    def luminance(values):
        channels = [v / 255 for v in values]
        linear = [v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4
                  for v in channels]
        return sum(weight * value for weight, value in zip((0.2126, 0.7152, 0.0722), linear))
    adjusted = tuple(rgb)
    while luminance(adjusted) > 0.30:
        adjusted = tuple(round(channel * 0.88) for channel in adjusted)
    return "#" + "".join(f"{channel:02x}" for channel in adjusted), adjusted


def _theme_css(theme="midnight", accent_color="blue"):
    """Apply one complete opaque palette while preserving the shared geometry."""
    import re as _re
    theme = theme if theme in THEME_TOKENS else "midnight"
    tokens = dict(THEME_TOKENS[theme])
    hex_color, rgb = _accent_for_theme(theme, accent_color)
    surface_rgb = tuple(int(tokens["card_surface"][i:i + 2], 16) for i in (1, 3, 5))
    mix = 0.13 if theme == "light" else 0.22
    tokens["active_surface"] = "#" + "".join(
        f"{round(bg * (1 - mix) + fg * mix):02x}" for bg, fg in zip(surface_rgb, rgb))
    tokens["accent_treatment"] = hex_color
    tokens["focus_treatment"] = hex_color
    css = CSS.replace(UI_TOKENS["accent"], hex_color)
    css = _re.sub(r"rgba\(10,132,255,([0-9.]+)\)",
                  lambda m: f"rgba({rgb[0]},{rgb[1]},{rgb[2]},{m.group(1)})", css)
    css = css.replace(UI_TOKENS["background"], tokens["window_background"])
    css = css.replace(UI_TOKENS["surface"], tokens["card_surface"])
    css = css.replace(UI_TOKENS["surface_secondary"], tokens["secondary_surface"])
    css = css.replace(UI_TOKENS["surface_active"], tokens["active_surface"])
    css = css.replace(UI_TOKENS["text_secondary"], tokens["secondary_text"])
    overrides = f"""
#root, #content-scroll, #content-scroll viewport {{ background-color: {tokens['window_background']}; color: {tokens['primary_text']}; }}
#root {{ border-color: {tokens['border_separator']}; }}
.module {{ background-color: {tokens['card_surface']}; border-color: {tokens['border_separator']}; }}
.control-divider {{ background-color: {tokens['border_separator']}; }}
.category-bar, .status-pill {{ background-color: {tokens['elevated_surface']}; }}
.sound-switch, scale trough {{ background-color: {tokens['slider_background']}; }}
#root .knob {{ background-color: {tokens['elevated_surface']}; border-color: {tokens['border_separator']}; }}
.category-button:hover, .back-button:hover, .chev:hover, .listitem:hover, .knob:hover {{ background-color: {tokens['hover']}; }}
