        footer = Gtk.Box(spacing=8)
        status = Gtk.Label(label="", xalign=0)
        status.set_hexpand(True)
        status.get_style_context().add_class("subtitle")
        save_button = Gtk.Button(label=T("notes_save"))
        save_button.get_style_context().add_class("knob")
        footer.pack_start(status, True, True, 0)
        footer.pack_end(save_button, False, False, 0)
        content.pack_start(footer, False, False, 0)

        state = {"loading": False, "dirty": False, "current": None, "notes": []}
        text_buffer = view.get_buffer()

        def load_notes(selected_id=None, include_current=False):
            state["loading"] = True
            state["notes"] = list_quick_notes()
            entries = list(state["notes"])
            current = state.get("current")
            if include_current and current and not any(n.get("id") == current.get("id") for n in entries):
                entries.insert(0, dict(current))
            selector.remove_all()
            for note in entries:
                selector.append(note["id"], note.get("title") or T("notes_new"))
            if selected_id and any(note["id"] == selected_id for note in entries):
                selector.set_active_id(selected_id)
            elif entries:
                selector.set_active(0)
            state["loading"] = False
            return entries

        def set_editor(note):
            state["loading"] = True
            state["current"] = dict(note)
            title_entry.set_text(note.get("title") or T("notes_new"))
            text_buffer.set_text(note.get("text") or "")
            state["dirty"] = False
            state["loading"] = False
            delete_button.set_sensitive(bool(note.get("saved", True)))

        def save_current(show_feedback=True):
            current = state.get("current")
            if not current or not state.get("dirty"):
                return True
            try:
                saved_id = save_quick_note(
                    current.get("id"), title_entry.get_text(),
                    text_buffer.get_text(text_buffer.get_start_iter(), text_buffer.get_end_iter(), True)
                )
            except (OSError, ValueError, TypeError) as exc:
                status.set_text(T("notes_error") + (": " + str(exc)[:100] if str(exc) else ""))
                if show_feedback:
                    self._toast(T("notes_error"), error=True)
                return False
            current.update({"id": saved_id, "title": title_entry.get_text().strip() or T("notes_new"), "saved": True})
            state["dirty"] = False
            load_notes(saved_id, include_current=True)
            if show_feedback:
                status.set_text(T("notes_saved"))
                self._toast(T("notes_saved"), timeout_ms=1300)
            return True

        def create_note(*_args):
            if not save_current(False):
                return
            note = {"id": str(uuid.uuid4()), "title": T("notes_new"), "text": "", "saved": False}
            set_editor(note)
            load_notes(note["id"], include_current=True)
            title_entry.grab_focus()
            title_entry.select_region(0, -1)
            status.set_text(T("notes_created"))

        def select_note(combo):
            if state["loading"]:
                return
            selected_id = combo.get_active_id()
            if not selected_id:
                return
            current = state.get("current")
            if current and current.get("id") == selected_id:
                return
            if not save_current(False):
                load_notes(current.get("id") if current else None, include_current=True)
                return
            note = next((n for n in list_quick_notes() if n["id"] == selected_id), None)
            if note is None:
                note = next((n for n in load_notes(selected_id, include_current=True) if n["id"] == selected_id), None)
            if note:
                note["saved"] = True
                set_editor(note)

        def delete_current(*_args):
            current = state.get("current")
            if not current:
                return
            exists = any(n["id"] == current.get("id") for n in list_quick_notes())
            if exists:
                confirm = Gtk.MessageDialog(transient_for=dialog, modal=True,
                    message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                    text=T("notes_delete_confirm"))
                confirm.add_button(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL)
                confirm.add_button(T("notes_delete"), Gtk.ResponseType.ACCEPT)
                response = confirm.run()
                confirm.destroy()
                if response != Gtk.ResponseType.ACCEPT:
                    return
                try:
                    delete_quick_note(current["id"])
                except (OSError, ValueError):
                    self._toast(T("notes_error"), error=True)
                    return
                self._toast(T("notes_deleted"), timeout_ms=1400)
            notes = list_quick_notes()
            if notes:
                note = notes[0]
                note["saved"] = True
                set_editor(note)
                load_notes(note["id"])
            else:
                create_note()

        def changed(*_args):
            if not state["loading"]:
                state["dirty"] = True
                status.set_text("•")

        def save_key(_widget, event):
            if (event.state & Gdk.ModifierType.CONTROL_MASK
                    and event.keyval in (Gdk.KEY_s, Gdk.KEY_S)):
                save_current(True)
                return True
            return False

        selector.connect("changed", select_note)
        new_button.connect("clicked", create_note)
        delete_button.connect("clicked", delete_current)
        save_button.connect("clicked", save_current)
        title_entry.connect("changed", changed)
        text_buffer.connect("changed", changed)
        view.connect("key-press-event", save_key)
        notes = load_notes()
        if notes:
            note = notes[0]
            note["saved"] = True
            set_editor(note)
            load_notes(note["id"])
        else:
            set_editor({"id": str(uuid.uuid4()), "title": T("notes_new"), "text": "", "saved": False})
            load_notes(state["current"]["id"], include_current=True)
        dialog.show_all()
        dialog.run()
        save_current(False)
        dialog.destroy()

