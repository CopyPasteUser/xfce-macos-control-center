PP_NAMES = {"power-saver": T("pp_saver"), "balanced": T("pp_balanced"), "performance": T("pp_perf")}
PP_ORDER = ["power-saver", "balanced", "performance"]
_PP = (("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles"),
       ("org.freedesktop.UPower.PowerProfiles", "/org/freedesktop/UPower/PowerProfiles"))


def pp_state():
    for name, path in _PP:
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            r = bus.call_sync(name, path, "org.freedesktop.DBus.Properties", "GetAll",
                              GLib.Variant("(s)", (name,)), None, Gio.DBusCallFlags.NONE, 2000, None)
            props = r.unpack()[0]
            profs = [p["Profile"] for p in props.get("Profiles", [])]
            profs.sort(key=lambda x: PP_ORDER.index(x) if x in PP_ORDER else 9)
            return props.get("ActiveProfile", ""), profs
        except Exception:
            continue
    return "", []


def pp_set(profile):
    for name, path in _PP:
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            bus.call_sync(name, path, "org.freedesktop.DBus.Properties", "Set",
                          GLib.Variant("(ssv)", (name, "ActiveProfile", GLib.Variant("s", profile))),
                          None, Gio.DBusCallFlags.NONE, 3000, None)
            return True
        except Exception:
            continue
    return False


