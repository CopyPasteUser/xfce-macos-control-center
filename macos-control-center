    def _open_workspace(self, page):
        existing = getattr(self, "_workspace_dialog", None)
        if existing is not None:
            existing.present()
            return
        self._cancel_focus_hide()
        dialog = Gtk.Dialog(title=T(page), transient_for=self, modal=True)
        self._workspace_dialog = dialog
        dialog.set_default_size(480, 410)
        dialog.add_button(Gtk.STOCK_CLOSE, Gtk.ResponseType.CLOSE)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.get_style_context().add_class("workspace")
        scroll.add(box)
        dialog.get_content_area().pack_start(scroll, True, True, 0)
        if page == "devices":
            self._fill_device_workspace(box)
        elif page == "focus":
            self._workspace_label(box, T("focus_help"))
            for minutes in (25, 45, 60):
                self._workspace_button(box, f"{minutes} min", lambda m=minutes: self._start_focus(m))
            self._workspace_button(box, T("focus_stop"), self._stop_focus)
        elif page == "resources":
            self._workspace_label(box, T("profile_help"))
            for key in ("light", "balanced", "responsive"):
                seconds, workers = _resource_policy(key)
                self._workspace_button(box, T("profile_" + key), lambda k=key: self._select_profile(k))
        elif page == "overview":
            snapshot = _system_snapshot()
            self._workspace_label(box, T("ram_usage", used=f"{snapshot.get('ram_used', 0):.1f}", total=f"{snapshot.get('ram_total', 0):.1f}"))
            self._workspace_label(box, T("load_average", load=f"{snapshot.get('load', 0):.2f}", cores=snapshot['cores']))
            self._workspace_label(box, T("uptime", minutes=snapshot.get("uptime", 0)))
            self._workspace_label(box, T("capabilities"))
            for title, available in (("NetworkManager", bool(which("nmcli"))),
                                     ("Bluetooth", bool(which("bluetoothctl")) and bool(glob.glob("/sys/class/bluetooth/hci*"))),
                                     ("Audio", bool(which("pactl"))),
                                     ("MPRIS", bool(which("playerctl"))),
                                     (T("brightness"), bool(BACKLIGHT)),
                                     (T("kbd_light"), bool(KBD_DIR)),
                                     (T("fan_control"), bool(glob.glob("/sys/class/hwmon/hwmon*")))):
                self._workspace_label(box, ("✓ " if available else "— ") + title + ("" if available else " · " + T("unavailable")))
            self._workspace_button(box, T("rescan"), self._rescan_devices)
            self._workspace_button(box, T("copy_diagnostics"), self._copy_diagnostics)
        dialog.show_all()
        try:
            dialog.run()
        finally:
            self._workspace_dialog = None
            dialog.destroy()
            if not self._destroyed:
                self._focus_guard_until = time.monotonic() + 0.75
                self.present()

    def _fill_device_workspace(self, box):
        for child in box.get_children():
            child.destroy()
        self._workspace_label(box, T("devices_help"))
        for index, device in enumerate(CFG.get("devices", [])):
            frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            frame.get_style_context().add_class("module")
            frame.set_border_width(6)
            self._workspace_label(frame, device["name"])
            row = Gtk.Box(spacing=6)
            if device["url"]:
                self._workspace_button(row, T("open"), lambda d=dict(device): self._open_device_url(d["url"]))
            if device["mac"]:
                self._workspace_button(row, T("wol_send"), lambda d=dict(device): self._wake_device(d))
            self._workspace_button(row, "✎", lambda i=index: self._edit_device(box, i))
            self._workspace_button(row, "−", lambda i=index: self._remove_device(box, i))
            frame.pack_start(row, False, False, 0)
            box.pack_start(frame, False, False, 0)
        self._workspace_button(box, T("device_add"), lambda: self._edit_device(box))
        box.show_all()

    def _edit_device(self, box, index=None):
        dialog = Gtk.Dialog(title=T("devices"), transient_for=self._workspace_dialog, modal=True)
        dialog.add_button(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL)
        dialog.add_button(Gtk.STOCK_SAVE, Gtk.ResponseType.OK)
        body = dialog.get_content_area()
        body.set_border_width(14)
        old = CFG["devices"][index] if index is not None else {}
        fields = {}
        for key in ("name", "url", "mac", "broadcast"):
            self._workspace_label(body, T("device_" + key))
            entry = Gtk.Entry()
            entry.set_width_chars(42)
            entry.set_text(old.get(key, "255.255.255.255" if key == "broadcast" else ""))
            body.pack_start(entry, False, False, 2)
            fields[key] = entry
        error = self._workspace_label(body, "")
        dialog.show_all()
        while dialog.run() == Gtk.ResponseType.OK:
            device = {k: v.get_text().strip() for k, v in fields.items()}
            validated = _validate_devices([device])
            if validated is None:
                error.set_text(T("device_invalid"))
                continue
            updated = list(CFG["devices"])
            if index is None:
                updated.extend(validated)
            else:
                updated[index] = validated[0]
            if _validate_devices(updated) is None or not self._save_setting("devices", updated):
                error.set_text(T("settings_failed"))
                continue
            break
        dialog.destroy()
        self._fill_device_workspace(box)

    def _remove_device(self, box, index):
        confirm = Gtk.MessageDialog(transient_for=self._workspace_dialog, modal=True,
                                    message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.OK_CANCEL,
                                    text=T("remove_device"))
        confirm.format_secondary_text(CFG["devices"][index]["name"])
        accepted = confirm.run() == Gtk.ResponseType.OK
        confirm.destroy()
        if accepted:
            updated = list(CFG["devices"])
            updated.pop(index)
            if self._save_setting("devices", updated):
                self._fill_device_workspace(box)

    def _open_device_url(self, url):
        try:
            subprocess.Popen(["xdg-open", url], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            self._device_feedback(T("launch_error"), True)

    def _wake_device(self, device):
        def work():
            try:
                _send_wol(device["mac"], device["broadcast"])
                message, error = T("wol_sent"), False
            except (OSError, ValueError):
                message, error = T("settings_failed"), True
            GLib.idle_add(self._device_feedback, message, error)
        threading.Thread(target=work, daemon=True).start()

    def _device_feedback(self, message, error):
        if self._destroyed:
            return False
        parent = getattr(self, "_workspace_dialog", None)
        if parent:
            notice = Gtk.MessageDialog(transient_for=parent, modal=True,
                message_type=Gtk.MessageType.ERROR if error else Gtk.MessageType.INFO,
                buttons=Gtk.ButtonsType.OK, text=message)
            notice.run()
            notice.destroy()
        else:
            self._toast(message, error=error)
        return False

    def _start_focus(self, minutes):
        self._stop_focus()
        self._focus_deadline = time.monotonic() + minutes * 60
        self._focus_tick()
        self._focus_source = GLib.timeout_add_seconds(1, self._focus_tick)
        self._toast(T("focus") + f" · {minutes} min")
        dialog = getattr(self, "_workspace_dialog", None)
        if dialog:
            dialog.response(Gtk.ResponseType.CLOSE)

    def _stop_focus(self):
        if self._focus_source:
            GLib.source_remove(self._focus_source)
        self._focus_source = 0
        self._focus_deadline = None
        self._focus_label.set_text("")

    def _focus_tick(self):
        if self._destroyed or self._focus_deadline is None:
            self._focus_source = 0
            return False
        remaining = max(0, math.ceil(self._focus_deadline - time.monotonic()))
        self._focus_label.set_text(T("focus") + f" · {remaining // 60:02}:{remaining % 60:02}")
        if remaining:
            return True
        self._focus_source = 0
        self._focus_deadline = None
        self._focus_label.set_text(T("focus_done"))
        if which("notify-send"):
            try:
                subprocess.Popen(["notify-send", T("focus"), T("focus_done")],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                pass
        return False

    def _select_profile(self, profile):
        if self._save_setting("resource_profile", profile):
            self._configure_polling()
            self._toast(T("settings_saved"))
            self._workspace_dialog.response(Gtk.ResponseType.CLOSE)

    def _configure_polling(self):
        # Retire a pool only after its active poll completes; never abandon futures.
        if self._polling:
            self._profile_pending = True
            return
        self._profile_pending = False
        seconds, workers = _resource_policy(CFG.get("resource_profile"), custom_seconds=CFG["poll_seconds"])
        self.POLL_SECONDS = seconds
        old = self._poll_executor
        self._poll_executor = ThreadPoolExecutor(max_workers=workers, thread_name_prefix="macos-cc-poll")
        old.shutdown(wait=False)
        if self._poll_source:
            GLib.source_remove(self._poll_source)
        self._poll_source = GLib.timeout_add_seconds(seconds, self._tick)

    def _build_actions(self, root):
        # Clean macOS-like symbol rail: icons only, no redundant lock/task-manager buttons.
        row = Gtk.Box(spacing=10, homogeneous=False)
        row.set_halign(Gtk.Align.CENTER)
        row.set_valign(Gtk.Align.CENTER)
        row.set_margin_top(2)
        row.set_margin_bottom(2)
        row.set_margin_start(4)
        row.set_margin_end(4)

        def add(key, tip, cb, svg):
            button = Gtk.Button()
            button.get_style_context().add_class("knob")
            button.set_image(svg_image(svg, 20))
            button.set_always_show_image(True)
            button.set_tooltip_text(tip)
            button.set_halign(Gtk.Align.CENTER)
            button.set_valign(Gtk.Align.CENTER)
            try:
                button.get_accessible().set_name(tip)
                button.get_accessible().set_description(tip)
            except Exception:
                pass
            button.connect("clicked", lambda _button: cb())
            row.pack_start(button, False, False, 0)
            self._act_btns[key] = button

        add("power", T("act_power"), lambda: self._act_toggle("power"), "power")
        add("tiles", T("customize_tiles"), lambda: self._act_toggle("tiles"), "grid")
        add("settings", T("settings_title"), lambda: self._act_toggle("settings"), "settings")

        self._act_rev = Gtk.Revealer()
        self._act_rev.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
        self._act_rev.set_transition_duration(self._animation_duration(160))
        pm = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        pm.get_style_context().add_class("module")
        pm.set_margin_top(8)
        self._act_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        for margin in ("top", "bottom", "start", "end"):
            getattr(self._act_list, f"set_margin_{margin}")(9)
        pm.pack_start(self._act_list, True, True, 0)
        self._act_rev.add(pm)

        wrapv = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        wrapv.pack_start(row, False, False, 0)
        wrapv.pack_start(self._act_rev, False, False, 0)
        root.pack_start(wrapv, False, False, 0)

    def _act_toggle(self, mode):
        if self._act_rev.get_reveal_child() and self._act_mode == mode:
            self._act_close()
            return
        self._clear_confirm()
        self._act_mode = mode
        self._act_rev.set_transition_duration(self._animation_duration(160))
        try:
            self._act_fill()
        except Exception:
            logging.exception("Settings/action page construction failed: %s", mode)
            self._act_close()
            self._toast(T("page_error"), error=True)
            return
        self._act_rev.set_reveal_child(True)
        self._schedule_dynamic_resize(185)
        for k, b in self._act_btns.items():
            ctx = b.get_style_context()
            ctx.add_class("on") if k == mode else ctx.remove_class("on")

    def _act_close(self):
        self._act_rev.set_reveal_child(False)
        self._act_mode = None
        self._clear_confirm()
        self._clear_power_confirmation()
        for b in self._act_btns.values():
            b.get_style_context().remove_class("on")
        GLib.timeout_add(220, self._shrink)

    def _act_fill(self):
        for c in self._act_list.get_children():
            self._act_list.remove(c)
        if self._act_mode == "shot":
            self._fill_shot()
        elif self._act_mode == "power":
            self._fill_power()
        elif self._act_mode == "tiles":
            self._fill_tiles()
        elif self._act_mode == "settings":
            self._fill_settings()
        elif self._act_mode == "settings_theme":
            self._fill_theme_options()
        elif self._act_mode == "settings_accent":
            self._fill_accent_options()
        elif self._act_mode == "settings_language":
            self._fill_language_options()
        elif self._act_mode == "settings_animation":
            self._fill_animation_options()
        elif self._act_mode == "diagnostics":
            self._fill_diag()
        self._act_list.show_all()
        self._schedule_dynamic_resize(50)

    def _settings_group(self, title):
        heading = Gtk.Label(label=title, xalign=0)
        heading.get_style_context().add_class("settings-section")
        heading.set_margin_start(5)
        heading.set_margin_top(7)
        heading.set_margin_bottom(2)
        self._act_list.pack_start(heading, False, False, 0)
        group = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        group.get_style_context().add_class("settings-group")
        self._act_list.pack_start(group, False, False, 1)
        return group

    def _settings_separator(self, group):
        if group.get_children():
            separator = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
            separator.get_style_context().add_class("control-divider")
            group.pack_start(separator, False, False, 0)

    def _settings_choice(self, group, title, value, callback, preview=None,
                         selected=False, chevron=True):
        self._settings_separator(group)
        button = Gtk.Button()
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.get_style_context().add_class("settings-row")
        row = Gtk.Box(spacing=8)
        label = Gtk.Label(label=title, xalign=0)
        label.set_ellipsize(3)
        label.set_max_width_chars(30)
        row.pack_start(label, True, True, 0)
        if preview:
            samples = Gtk.Box(spacing=3)
            preview_kind, preview_value = preview.split(":", 1)
            palette = (THEME_TOKENS.get(preview_value, THEME_TOKENS["midnight"])
                       if preview_kind == "theme" else
                       {"window_background": UI_TOKENS["background"],
                        "card_surface": UI_TOKENS["surface"],
                        "accent_treatment": ACCENT_PALETTE.get(
                            preview_value, ACCENT_PALETTE["blue"])[0]})
            for color in (palette["window_background"], palette["card_surface"],
                          palette.get("accent_treatment", ACCENT_PALETTE["blue"][0])):
                swatch = Gtk.EventBox()
                swatch.set_visible_window(True)
                swatch.set_size_request(11, 11)
                rgba = Gdk.RGBA()
                rgba.parse(color)
                swatch.override_background_color(Gtk.StateFlags.NORMAL, rgba)
                samples.pack_start(swatch, False, False, 0)
            row.pack_start(samples, False, False, 0)
        elif value:
            value_label = Gtk.Label(label=value, xalign=1)
            value_label.get_style_context().add_class("settings-value")
            value_label.set_ellipsize(3)
            value_label.set_max_width_chars(18)
            row.pack_start(value_label, False, False, 0)
        if chevron:
            row.pack_end(Gtk.Image.new_from_icon_name("go-next-symbolic", Gtk.IconSize.MENU), False, False, 0)
        if selected:
            check = Gtk.Image.new_from_icon_name("object-select-symbolic", Gtk.IconSize.MENU)
            check.get_style_context().add_class("settings-selected")
            row.pack_end(check, False, False, 0)
        button.add(row)
        button.set_tooltip_text(title + (": " + value if value else ""))
        try:
            button.get_accessible().set_name(title + (": " + value if value else ""))
        except Exception:
            pass
        button.connect("clicked", lambda *_: callback())
        group.pack_start(button, False, False, 0)
        return button

    def _settings_toggle(self, group, title, enabled, callback):
        self._settings_separator(group)
        row = Gtk.Box(spacing=8)
        row.get_style_context().add_class("settings-toggle-row")
        label = Gtk.Label(label=title, xalign=0)
        label.set_ellipsize(3)
        label.set_max_width_chars(34)
        row.pack_start(label, True, True, 0)
        switch = Gtk.Switch()
        switch.set_active(bool(enabled))
        switch.set_valign(Gtk.Align.CENTER)
        switch.get_style_context().add_class("settings-switch")
        def changed(widget, *_args):
            if callback() is False:
                widget.handler_block(handler)
                widget.set_active(not widget.get_active())
                widget.handler_unblock(handler)
        handler = switch.connect("notify::active", changed)
        switch.set_tooltip_text(title)
        row.pack_end(switch, False, False, 0)
        group.pack_start(row, False, False, 0)
        return switch

    def _fill_settings(self):
        self._item(T("back"), self._act_close)
        appearance = self._settings_group(T("appearance"))
        theme = CFG.get("theme", "midnight")
        accent = CFG.get("accent_color", "blue")
        language = CFG.get("language", "auto")
        self._settings_choice(appearance, T("setting_theme"), T("theme_" + theme),
                              lambda: self._act_toggle("settings_theme"), preview="theme:" + theme)
        self._settings_choice(appearance, T("setting_accent"), T("accent_" + accent),
                              lambda: self._act_toggle("settings_accent"), preview="accent:" + accent)
        self._settings_choice(appearance, T("setting_language"), T("language_" + language),
                              lambda: self._act_toggle("settings_language"))

        controls = self._settings_group(T("setting_quick_actions"))
        self._settings_choice(controls, T("setting_quick_actions"), "",
                              lambda: self._act_toggle("tiles"))
        self._settings_choice(controls, T("devices"), str(len(CFG.get("devices", []))),
                              lambda: self._open_workspace("devices"))
        self._settings_toggle(controls, T("setting_compact"), CFG.get("compact_actions", True),
                              self._toggle_compact_setting)
        self._settings_toggle(controls, T("setting_media_card"), CFG.get("media_card", True),
                              self._toggle_media_card)
        self._settings_toggle(controls, T("setting_media_art"), CFG.get("media_thumbnail", True),
                              self._toggle_media_thumbnail)
        self._settings_toggle(controls, T("setting_media_progress"), CFG.get("media_progress", True),
                              lambda: self._toggle_preference("media_progress"))
        self._settings_toggle(controls, T("setting_media_idle"), CFG.get("media_hide_idle", False),
                              lambda: self._toggle_preference("media_hide_idle"))

        behavior = self._settings_group(T("behavior"))
        self._settings_toggle(behavior, T("setting_feedback"), CFG.get("feedback", True),
                              lambda: self._toggle_preference("feedback"))
        self._settings_toggle(behavior, T("setting_animations"), CFG.get("reduce_motion", False),
                              self._toggle_reduce_motion)
        self._settings_toggle(behavior, T("setting_focus_close"), not CFG.get("stay_open", False),
                              self._toggle_stay_open)
        self._settings_choice(behavior, T("setting_animation_speed"),
                              T("animation_" + CFG.get("animation_speed", "smooth")),
                              lambda: self._act_toggle("settings_animation"))

        monitoring = self._settings_group(T("resources"))
        self._settings_choice(monitoring, T("setting_resource"),
                              T("profile_" + CFG.get("resource_profile", "balanced")),
                              lambda: self._open_workspace("resources"))
        self._settings_choice(monitoring, T("setting_refresh"),
                              T("poll_interval", s=self.POLL_SECONDS), self._cycle_poll_interval)
        about = self._settings_group(T("diagnostics"))
        self._settings_choice(about, T("setting_diagnostics"), APP_VERSION,
                              lambda: self._act_toggle("diagnostics"))

    def _fill_theme_options(self):
        self._head(T("setting_theme"))
        group = self._settings_group(T("appearance"))
        for value in ("midnight", "graphite", "frosted", "light"):
            self._settings_choice(group, T("theme_" + value), "",
                                  lambda v=value: self._select_setting("theme", v, visual=True),
                                  preview="theme:" + value, selected=CFG.get("theme") == value,
                                  chevron=False)
        self._item(T("settings_title"), lambda: self._act_toggle("settings"))

    def _fill_accent_options(self):
        self._head(T("setting_accent"))
        group = self._settings_group(T("appearance"))
        for value in _CFG_ACCENTS:
            self._settings_choice(group, T("accent_" + value), "",
                                  lambda v=value: self._select_setting("accent_color", v, visual=True),
                                  preview="accent:" + value, selected=CFG.get("accent_color") == value,
                                  chevron=False)
        self._item(T("settings_title"), lambda: self._act_toggle("settings"))

    def _fill_language_options(self):
        self._head(T("setting_language"))
        group = self._settings_group(T("appearance"))
        for value in ("auto", "de", "en", "it", "fr", "es"):
            self._settings_choice(group, T("language_" + value), "",
                                  lambda v=value: self._select_language(v),
                                  selected=CFG.get("language") == value, chevron=False)
        self._item(T("settings_title"), lambda: self._act_toggle("settings"))

    def _fill_animation_options(self):
        self._head(T("setting_animation_speed"))
        group = self._settings_group(T("behavior"))
        for value in ("smooth", "fast", "off"):
            self._settings_choice(group, T("animation_" + value), "",
                                  lambda v=value: self._select_setting("animation_speed", v, visual=False),
                                  selected=CFG.get("animation_speed") == value, chevron=False)
        self._item(T("settings_title"), lambda: self._act_toggle("settings"))

    def _select_setting(self, key, value, visual=False):
        if not self._save_setting(key, value):
            return
        if visual:
            self._apply_visual_preferences()
        if key == "animation_speed":
            duration = self._animation_duration(160)
            self._content_stack.set_transition_duration(duration)
            self._act_rev.set_transition_duration(duration)
            self._schedule_dynamic_resize(40)
        self._act_toggle("settings")
        self._toast(T("settings_saved"))

    def _select_language(self, value):
        if value == CFG.get("language", "auto"):
            self._act_toggle("settings")
            return
        if self._save_setting("language", value):
            self._toast(T("language_restart"), timeout_ms=650)
            GLib.timeout_add(750, self._restart_for_language)

    def _save_setting(self, key, value):
        cleaned = _cfg_value(key, value)
        if cleaned is None:
            self._toast(T("settings_failed"), error=True)
            return False
        updated = dict(CFG)
        updated[key] = cleaned
        if not _persist_config(updated):
            self._toast(T("settings_failed"), error=True)
            return False
        CFG.update(updated)
        return True

    def _toggle_preference(self, key):
        if key not in ("media_progress", "media_hide_idle", "feedback"):
            return False
        if not self._save_setting(key, not CFG[key]):
            return False
        if key.startswith("media_"):
            self._set_media(self._last.get("media"))
            self._schedule_dynamic_resize(50)
        self._act_fill()
        return True

    def _cycle_theme(self):
        choices = _CFG_THEMES
        current = CFG.get("theme", "midnight")
        value = choices[(choices.index(current) + 1) % len(choices)]
        if self._save_setting("theme", value):
            self._apply_visual_preferences()
            self._act_fill()
            self._toast(T("settings_saved"))

    def _cycle_accent(self):
        choices = _CFG_ACCENTS
        current = CFG.get("accent_color", "blue")
        value = choices[(choices.index(current) + 1) % len(choices)]
        if self._save_setting("accent_color", value):
            self._apply_visual_preferences()
            self._act_fill()
            self._toast(T("settings_saved"))

    def _apply_visual_preferences(self):
        global ACCENT
        ACCENT = _accent_for_theme(CFG.get("theme", "midnight"),
                                   CFG.get("accent_color", "blue"))[0]
        try:
            self._css_provider.load_from_data(
                _theme_css(CFG.get("theme", "midnight"), CFG.get("accent_color", "blue")).encode()
            )
        except Exception:
            pass
        for holder in (self.btn_wifi, self.btn_bt, self.btn_vpn, self.btn_ns):
            if not holder:
                continue
            button = holder[1]
            icon_name = self._toggle_icons.get(id(button))
            if icon_name:
                active = button.get_style_context().has_class("on")
                button.set_image(svg_image(icon_name, color=(ACCENT if active else _inactive_icon_color())))
        if self._tile_info is not None:
            self._tiles_build(self._tile_info)

    def _cycle_animation_speed(self):
        choices = ("smooth", "fast", "off")
        current = CFG.get("animation_speed", "smooth")
        value = choices[(choices.index(current) + 1) % len(choices)]
        if self._save_setting("animation_speed", value):
            duration = self._animation_duration(160)
            self._content_stack.set_transition_duration(duration)
            self._act_rev.set_transition_duration(duration)
            self._toast(T("settings_saved"))
            self._act_fill()

    def _cycle_language(self):
        choices = ("auto", "de", "en", "it", "fr", "es")
        current = CFG.get("language", "auto")
        value = choices[(choices.index(current) + 1) % len(choices)]
        if self._save_setting("language", value):
            self._toast(T("language_restart"), timeout_ms=650)
            GLib.timeout_add(750, self._restart_for_language)

    def _restart_for_language(self):
        # Re-exec the current script in the same PID; main() skips stale-PID logic
        # only for this internal restart and reopens the resident popup visibly.
        os.environ["CC_INTERNAL_RESTART"] = "1"
        os.environ["CC_START_VISIBLE"] = "1"
