    def _detail_fill(self, mode, data):
        if self._destroyed or mode != self._detail_mode:
            return False
        if mode == "network":
            for child in self._network_list.get_children():
                self._network_list.remove(child)
            if data == "off" or not data:
                self._network_list.pack_start(Gtk.Label(label=T("wifi_off" if data == "off" else "network_unavailable"), xalign=0), False, False, 0)
            else:
                current = Gtk.Label(label=T("network_current"), xalign=0)
                current.get_style_context().add_class("detail-key")
                self._network_list.pack_start(current, False, False, 2)
                if data.get("ssid"):
                    ssid = Gtk.Label(label=data["ssid"], xalign=0)
                    ssid.get_style_context().add_class("title")
                    ssid.set_ellipsize(3)
                    ssid.set_max_width_chars(34)
                    self._network_list.pack_start(ssid, False, False, 1)
                separator = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
                separator.get_style_context().add_class("control-divider")
                self._network_list.pack_start(separator, False, False, 7)
                fields = (("network_device", data.get("device", "")),
                          ("network_ip", data.get("ip", "")),
                          ("network_gateway", data.get("gateway", "")),
                          ("network_dns", data.get("dns", "")))
                for key, value in fields:
                    if not value:
                        continue
                    row = Gtk.Box(spacing=10)
                    row.get_style_context().add_class("network-row")
                    label = Gtk.Label(label=T(key + "_label"), xalign=0)
                    label.get_style_context().add_class("detail-key")
                    label.set_size_request(72, -1)
                    value_label = Gtk.Label(label=value, xalign=1)
                    value_label.get_style_context().add_class("title")
                    value_label.set_line_wrap(True)
                    value_label.set_max_width_chars(30)
                    value_label.set_selectable(True)
                    row.pack_start(label, False, False, 0)
                    row.pack_start(value_label, True, True, 0)
                    self._network_list.pack_start(row, False, False, 5)
            self._network_list.show_all()
            self._schedule_dynamic_resize(45)
            return False
        if mode == "wifi" and self._pw_active:
            return False          # Passwortabfrage bleibt stehen
        if data == "off":
            self._detail_set_msg(T("wifi_off") if mode == "wifi"
                                 else T("bt_off"))
            return False
        network_summary = None
        if mode == "wifi" and isinstance(data, dict):
            network_summary = data.get("summary") or {}
            data = data.get("networks", [])
        if not data and not network_summary:
            self._detail_set_msg({"wifi": T("no_networks"),
                                  "bt": T("no_paired"),
                                  "vpn": T("no_vpn_cfg")}[mode])
            return False
        self._detail_clear()
        if mode == "wifi":
            if network_summary:
                current_header = Gtk.Label(label=T("network_current"), xalign=0)
                current_header.get_style_context().add_class("ttitle")
                self._detail_list.pack_start(current_header, False, False, 2)
                if network_summary.get("ssid"):
                    current_name = Gtk.Label(label=network_summary["ssid"], xalign=0)
                    current_name.get_style_context().add_class("title")
                    self._detail_list.pack_start(current_name, False, False, 1)
                if network_summary.get("signal"):
                    meta = T("network_meta", signal=network_summary["signal"], security=network_summary.get("security", ""))
                    status = Gtk.Label(label=meta, xalign=0)
                    status.get_style_context().add_class("subtitle")
                    self._detail_list.pack_start(status, False, False, 2)
                network_button = Gtk.Button(label=T("quick_network"))
                network_button.get_style_context().add_class("listitem")
                network_button.connect("clicked", lambda *_: self._detail_toggle("network"))
                self._detail_list.pack_start(network_button, False, False, 3)
                separator = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
                self._detail_list.pack_start(separator, False, False, 5)
            if not data:
                empty = Gtk.Label(label=T("no_networks"), xalign=0)
                empty.get_style_context().add_class("subtitle")
                self._detail_list.pack_start(empty, False, False, 2)
            for ssid, inuse, sig, sec in data:
                mark = ((T("connected") + " · ") if inuse else "") + T("network_meta", signal=sig, security=sec or "Open")
                self._detail_list.pack_start(
                    self._detail_item(ssid, mark, lambda _b, s=ssid, sc=sec: self._wifi_connect(s, sc)),
                    False, False, 0)
        elif mode == "bt":
            for mac, name, conn, bat in data:
                mark = ""
                if conn:
                    mark = T("connected") + (f" · {bat}%" if bat is not None else "")
                self._detail_list.pack_start(
                    self._detail_item(name, mark,
                                      lambda _b, a=mac, c=conn: self._bt_toggle(a, c)),
                    False, False, 0)
        else:
            for name, active in data:
                self._detail_list.pack_start(
                    self._detail_item(name, T("connected") if active else "",
                                      lambda _b, n=name, a=active: self._vpn_run(n, a)),
                    False, False, 0)
        self._detail_list.show_all()
        self._schedule_dynamic_resize(45)
        return False

    def _wifi_connect(self, ssid, sec=""):
        if self._busy.get("wifi"):
            return
        self._busy["wifi"] = True
        self._last.pop("wifi", None)
        self.btn_wifi[2].set_text(T("connecting"))
        threading.Thread(target=self._wifi_worker, args=(ssid, sec), daemon=True).start()

    def _wifi_worker(self, ssid, sec):
        # 1. gespeichertes Profil (nach SSID gefunden)  2. offenes Netz  3. sonst Passwort erfragen
        status = "failed"
        try:
            saved = saved_wifi_profiles(ssid)
            if saved:
                for name in saved:
                    r = subprocess.run(["nmcli", "-w", "15", "connection", "up", "id", name],
                                       capture_output=True, timeout=20)
                    if r.returncode == 0:
                        status = "ok"
                        break
            elif wifi_is_open(sec):
                r = subprocess.run(["nmcli", "-w", "15", "dev", "wifi", "connect", ssid],
                                   capture_output=True, timeout=20)
                status = "ok" if r.returncode == 0 else "failed"
            elif "802.1X" in sec or "WEP" in sec:
                status = "unsupported"
            else:
                status = "need_password"
        except Exception:
            status = "failed"
        GLib.idle_add(self._wifi_done, ssid, status)

    def _wifi_done(self, ssid, status):
        if self._destroyed:
            return False
        if status == "need_password":
            if self._current_page != "detail" or self._detail_mode != "wifi":
                self._busy["wifi"] = False
                return False
            self._wifi_prompt(ssid)       # busy bleibt, bis die Eingabe beendet ist
            return False
        self._busy["wifi"] = False
        self._last.pop("wifi", None)
        if status == "ok":
            self.btn_wifi[2].set_text(ssid)
            self._detail_reload()
        elif status == "unsupported":
            self.btn_wifi[2].set_text(T("failed"))
            self._detail_set_msg(T("wifi_unsupported"))
            GLib.timeout_add(3500, self._detail_reload_once)
        else:
            self.btn_wifi[2].set_text(T("failed"))
            if self._detail_mode == "wifi":
                self._detail_set_msg(T("wifi_connect_failed"))
                GLib.timeout_add(3500, self._detail_reload_once)
            else:
                self._detail_reload()
        return False

    def _detail_reload_once(self):
        self._detail_reload()
        return False

